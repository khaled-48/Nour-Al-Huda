{"surah_id":86,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","juz":30,"page":591},{"ayah_number":2,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","juz":30,"page":591},{"ayah_number":3,"text_uthmani":"ٱلنَّجْمُ ٱلثَّاقِبُ","juz":30,"page":591},{"ayah_number":4,"text_uthmani":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","juz":30,"page":591},{"ayah_number":5,"text_uthmani":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","juz":30,"page":591},{"ayah_number":6,"text_uthmani":"خُلِقَ مِن مَّآءٍ دَافِقٍ","juz":30,"page":591},{"ayah_number":7,"text_uthmani":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","juz":30,"page":591},{"ayah_number":8,"text_uthmani":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","juz":30,"page":591},{"ayah_number":9,"text_uthmani":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","juz":30,"page":591},{"ayah_number":10,"text_uthmani":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","juz":30,"page":591},{"ayah_number":11,"text_uthmani":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","juz":30,"page":591},{"ayah_number":12,"text_uthmani":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","juz":30,"page":591},{"ayah_number":13,"text_uthmani":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","juz":30,"page":591},{"ayah_number":14,"text_uthmani":"وَمَا هُوَ بِٱلْهَزْلِ","juz":30,"page":591},{"ayah_number":15,"text_uthmani":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","juz":30,"page":591},{"ayah_number":16,"text_uthmani":"وَأَكِيدُ كَيْدًا","juz":30,"page":591},{"ayah_number":17,"text_uthmani":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","juz":30,"page":591}]}