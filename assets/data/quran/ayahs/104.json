{"surah_id":104,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","juz":30,"page":601},{"ayah_number":2,"text_uthmani":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","juz":30,"page":601},{"ayah_number":3,"text_uthmani":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","juz":30,"page":601},{"ayah_number":4,"text_uthmani":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","juz":30,"page":601},{"ayah_number":5,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","juz":30,"page":601},{"ayah_number":6,"text_uthmani":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","juz":30,"page":601},{"ayah_number":7,"text_uthmani":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","juz":30,"page":601},{"ayah_number":8,"text_uthmani":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","juz":30,"page":601},{"ayah_number":9,"text_uthmani":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","juz":30,"page":601}]}