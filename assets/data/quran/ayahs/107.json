{"surah_id":107,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","juz":30,"page":602},{"ayah_number":2,"text_uthmani":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","juz":30,"page":602},{"ayah_number":3,"text_uthmani":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","juz":30,"page":602},{"ayah_number":4,"text_uthmani":"فَوَيْلٌ لِّلْمُصَلِّينَ","juz":30,"page":602},{"ayah_number":5,"text_uthmani":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","juz":30,"page":602},{"ayah_number":6,"text_uthmani":"ٱلَّذِينَ هُمْ يُرَآءُونَ","juz":30,"page":602},{"ayah_number":7,"text_uthmani":"وَيَمْنَعُونَ ٱلْمَاعُونَ","juz":30,"page":602}]}