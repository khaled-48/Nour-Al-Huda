{"surah_id":95,"ayahs":[{"ayah_number":1,"text_uthmani":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ","juz":30,"page":597},{"ayah_number":2,"text_uthmani":"وَطُورِ سِينِينَ","juz":30,"page":597},{"ayah_number":3,"text_uthmani":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","juz":30,"page":597},{"ayah_number":4,"text_uthmani":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ","juz":30,"page":597},{"ayah_number":5,"text_uthmani":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ","juz":30,"page":597},{"ayah_number":6,"text_uthmani":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","juz":30,"page":597},{"ayah_number":7,"text_uthmani":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","juz":30,"page":597},{"ayah_number":8,"text_uthmani":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ","juz":30,"page":597}]}