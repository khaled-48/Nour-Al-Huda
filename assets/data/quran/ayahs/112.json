{"surah_id":112,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","juz":30,"page":604},{"ayah_number":2,"text_uthmani":"ٱللَّهُ ٱلصَّمَدُ","juz":30,"page":604},{"ayah_number":3,"text_uthmani":"لَمْ يَلِدْ وَلَمْ يُولَدْ","juz":30,"page":604},{"ayah_number":4,"text_uthmani":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","juz":30,"page":604}]}