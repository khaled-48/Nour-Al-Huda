{"surah_id":85,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","juz":30,"page":590},{"ayah_number":2,"text_uthmani":"وَٱلْيَوْمِ ٱلْمَوْعُودِ","juz":30,"page":590},{"ayah_number":3,"text_uthmani":"وَشَاهِدٍ وَمَشْهُودٍ","juz":30,"page":590},{"ayah_number":4,"text_uthmani":"قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ","juz":30,"page":590},{"ayah_number":5,"text_uthmani":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","juz":30,"page":590},{"ayah_number":6,"text_uthmani":"إِذْ هُمْ عَلَيْهَا قُعُودٌ","juz":30,"page":590},{"ayah_number":7,"text_uthmani":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ","juz":30,"page":590},{"ayah_number":8,"text_uthmani":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","juz":30,"page":590},{"ayah_number":9,"text_uthmani":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","juz":30,"page":590},{"ayah_number":10,"text_uthmani":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","juz":30,"page":590},{"ayah_number":11,"text_uthmani":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ","juz":30,"page":590},{"ayah_number":12,"text_uthmani":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","juz":30,"page":590},{"ayah_number":13,"text_uthmani":"إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ","juz":30,"page":590},{"ayah_number":14,"text_uthmani":"وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ","juz":30,"page":590},{"ayah_number":15,"text_uthmani":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","juz":30,"page":590},{"ayah_number":16,"text_uthmani":"فَعَّالٌ لِّمَا يُرِيدُ","juz":30,"page":590},{"ayah_number":17,"text_uthmani":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ","juz":30,"page":590},{"ayah_number":18,"text_uthmani":"فِرْعَوْنَ وَثَمُودَ","juz":30,"page":590},{"ayah_number":19,"text_uthmani":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ","juz":30,"page":590},{"ayah_number":20,"text_uthmani":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ","juz":30,"page":590},{"ayah_number":21,"text_uthmani":"بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ","juz":30,"page":590},{"ayah_number":22,"text_uthmani":"فِى لَوْحٍ مَّحْفُوظٍۭ","juz":30,"page":590}]}