{"surah_id":109,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","juz":30,"page":603},{"ayah_number":2,"text_uthmani":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","juz":30,"page":603},{"ayah_number":3,"text_uthmani":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","juz":30,"page":603},{"ayah_number":4,"text_uthmani":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","juz":30,"page":603},{"ayah_number":5,"text_uthmani":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","juz":30,"page":603},{"ayah_number":6,"text_uthmani":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","juz":30,"page":603}]}