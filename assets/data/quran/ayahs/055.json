{"surah_id":55,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلرَّحْمَـٰنُ","juz":27,"page":531},{"ayah_number":2,"text_uthmani":"عَلَّمَ ٱلْقُرْءَانَ","juz":27,"page":531},{"ayah_number":3,"text_uthmani":"خَلَقَ ٱلْإِنسَـٰنَ","juz":27,"page":531},{"ayah_number":4,"text_uthmani":"عَلَّمَهُ ٱلْبَيَانَ","juz":27,"page":531},{"ayah_number":5,"text_uthmani":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ","juz":27,"page":531},{"ayah_number":6,"text_uthmani":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","juz":27,"page":531},{"ayah_number":7,"text_uthmani":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","juz":27,"page":531},{"ayah_number":8,"text_uthmani":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ","juz":27,"page":531},{"ayah_number":9,"text_uthmani":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ","juz":27,"page":531},{"ayah_number":10,"text_uthmani":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ","juz":27,"page":531},{"ayah_number":11,"text_uthmani":"فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","juz":27,"page":531},{"ayah_number":12,"text_uthmani":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","juz":27,"page":531},{"ayah_number":13,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":531},{"ayah_number":14,"text_uthmani":"خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ","juz":27,"page":531},{"ayah_number":15,"text_uthmani":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ","juz":27,"page":531},{"ayah_number":16,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":531},{"ayah_number":17,"text_uthmani":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ","juz":27,"page":532},{"ayah_number":18,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":19,"text_uthmani":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ","juz":27,"page":532},{"ayah_number":20,"text_uthmani":"بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ","juz":27,"page":532},{"ayah_number":21,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":22,"text_uthmani":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ","juz":27,"page":532},{"ayah_number":23,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":24,"text_uthmani":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ","juz":27,"page":532},{"ayah_number":25,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":26,"text_uthmani":"كُلُّ مَنْ عَلَيْهَا فَانٍ","juz":27,"page":532},{"ayah_number":27,"text_uthmani":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ","juz":27,"page":532},{"ayah_number":28,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":29,"text_uthmani":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ","juz":27,"page":532},{"ayah_number":30,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":31,"text_uthmani":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","juz":27,"page":532},{"ayah_number":32,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":33,"text_uthmani":"يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ","juz":27,"page":532},{"ayah_number":34,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":35,"text_uthmani":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ","juz":27,"page":532},{"ayah_number":36,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":37,"text_uthmani":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ","juz":27,"page":532},{"ayah_number":38,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":39,"text_uthmani":"فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ","juz":27,"page":532},{"ayah_number":40,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"ayah_number":41,"text_uthmani":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ","juz":27,"page":533},{"ayah_number":42,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":43,"text_uthmani":"هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ","juz":27,"page":533},{"ayah_number":44,"text_uthmani":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ","juz":27,"page":533},{"ayah_number":45,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":46,"text_uthmani":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","juz":27,"page":533},{"ayah_number":47,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":48,"text_uthmani":"ذَوَاتَآ أَفْنَانٍ","juz":27,"page":533},{"ayah_number":49,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":50,"text_uthmani":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ","juz":27,"page":533},{"ayah_number":51,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":52,"text_uthmani":"فِيهِمَا مِن كُلِّ فَـٰكِهَةٍ زَوْجَانِ","juz":27,"page":533},{"ayah_number":53,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":54,"text_uthmani":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ","juz":27,"page":533},{"ayah_number":55,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":56,"text_uthmani":"فِيهِنَّ قَـٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ","juz":27,"page":533},{"ayah_number":57,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":58,"text_uthmani":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ","juz":27,"page":533},{"ayah_number":59,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":60,"text_uthmani":"هَلْ جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ","juz":27,"page":533},{"ayah_number":61,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":62,"text_uthmani":"وَمِن دُونِهِمَا جَنَّتَانِ","juz":27,"page":533},{"ayah_number":63,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":64,"text_uthmani":"مُدْهَآمَّتَانِ","juz":27,"page":533},{"ayah_number":65,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":66,"text_uthmani":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ","juz":27,"page":533},{"ayah_number":67,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"ayah_number":68,"text_uthmani":"فِيهِمَا فَـٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ","juz":27,"page":534},{"ayah_number":69,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":534},{"ayah_number":70,"text_uthmani":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌ","juz":27,"page":534},{"ayah_number":71,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":534},{"ayah_number":72,"text_uthmani":"حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ","juz":27,"page":534},{"ayah_number":73,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":534},{"ayah_number":74,"text_uthmani":"لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ","juz":27,"page":534},{"ayah_number":75,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":534},{"ayah_number":76,"text_uthmani":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ","juz":27,"page":534},{"ayah_number":77,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":534},{"ayah_number":78,"text_uthmani":"تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ","juz":27,"page":534}]}