{"surah_id":113,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","juz":30,"page":604},{"ayah_number":2,"text_uthmani":"مِن شَرِّ مَا خَلَقَ","juz":30,"page":604},{"ayah_number":3,"text_uthmani":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","juz":30,"page":604},{"ayah_number":4,"text_uthmani":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ","juz":30,"page":604},{"ayah_number":5,"text_uthmani":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","juz":30,"page":604}]}