{"surah_id":105,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ","juz":30,"page":601},{"ayah_number":2,"text_uthmani":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","juz":30,"page":601},{"ayah_number":3,"text_uthmani":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","juz":30,"page":601},{"ayah_number":4,"text_uthmani":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","juz":30,"page":601},{"ayah_number":5,"text_uthmani":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ","juz":30,"page":601}]}