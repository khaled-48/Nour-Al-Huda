{"surah_id":69,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ","juz":29,"page":566},{"ayah_number":2,"text_uthmani":"مَا ٱلْحَآقَّةُ","juz":29,"page":566},{"ayah_number":3,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","juz":29,"page":566},{"ayah_number":4,"text_uthmani":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","juz":29,"page":566},{"ayah_number":5,"text_uthmani":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","juz":29,"page":566},{"ayah_number":6,"text_uthmani":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","juz":29,"page":566},{"ayah_number":7,"text_uthmani":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","juz":29,"page":566},{"ayah_number":8,"text_uthmani":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","juz":29,"page":566},{"ayah_number":9,"text_uthmani":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ","juz":29,"page":567},{"ayah_number":10,"text_uthmani":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","juz":29,"page":567},{"ayah_number":11,"text_uthmani":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ","juz":29,"page":567},{"ayah_number":12,"text_uthmani":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ","juz":29,"page":567},{"ayah_number":13,"text_uthmani":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ","juz":29,"page":567},{"ayah_number":14,"text_uthmani":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً","juz":29,"page":567},{"ayah_number":15,"text_uthmani":"فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ","juz":29,"page":567},{"ayah_number":16,"text_uthmani":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ","juz":29,"page":567},{"ayah_number":17,"text_uthmani":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَـٰنِيَةٌ","juz":29,"page":567},{"ayah_number":18,"text_uthmani":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ","juz":29,"page":567},{"ayah_number":19,"text_uthmani":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ","juz":29,"page":567},{"ayah_number":20,"text_uthmani":"إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ","juz":29,"page":567},{"ayah_number":21,"text_uthmani":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","juz":29,"page":567},{"ayah_number":22,"text_uthmani":"فِى جَنَّةٍ عَالِيَةٍ","juz":29,"page":567},{"ayah_number":23,"text_uthmani":"قُطُوفُهَا دَانِيَةٌ","juz":29,"page":567},{"ayah_number":24,"text_uthmani":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","juz":29,"page":567},{"ayah_number":25,"text_uthmani":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ","juz":29,"page":567},{"ayah_number":26,"text_uthmani":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","juz":29,"page":567},{"ayah_number":27,"text_uthmani":"يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ","juz":29,"page":567},{"ayah_number":28,"text_uthmani":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ","juz":29,"page":567},{"ayah_number":29,"text_uthmani":"هَلَكَ عَنِّى سُلْطَـٰنِيَهْ","juz":29,"page":567},{"ayah_number":30,"text_uthmani":"خُذُوهُ فَغُلُّوهُ","juz":29,"page":567},{"ayah_number":31,"text_uthmani":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","juz":29,"page":567},{"ayah_number":32,"text_uthmani":"ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ","juz":29,"page":567},{"ayah_number":33,"text_uthmani":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","juz":29,"page":567},{"ayah_number":34,"text_uthmani":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","juz":29,"page":567},{"ayah_number":35,"text_uthmani":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ","juz":29,"page":568},{"ayah_number":36,"text_uthmani":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ","juz":29,"page":568},{"ayah_number":37,"text_uthmani":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ","juz":29,"page":568},{"ayah_number":38,"text_uthmani":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","juz":29,"page":568},{"ayah_number":39,"text_uthmani":"وَمَا لَا تُبْصِرُونَ","juz":29,"page":568},{"ayah_number":40,"text_uthmani":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","juz":29,"page":568},{"ayah_number":41,"text_uthmani":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ","juz":29,"page":568},{"ayah_number":42,"text_uthmani":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ","juz":29,"page":568},{"ayah_number":43,"text_uthmani":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","juz":29,"page":568},{"ayah_number":44,"text_uthmani":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","juz":29,"page":568},{"ayah_number":45,"text_uthmani":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","juz":29,"page":568},{"ayah_number":46,"text_uthmani":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","juz":29,"page":568},{"ayah_number":47,"text_uthmani":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ","juz":29,"page":568},{"ayah_number":48,"text_uthmani":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ","juz":29,"page":568},{"ayah_number":49,"text_uthmani":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","juz":29,"page":568},{"ayah_number":50,"text_uthmani":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ","juz":29,"page":568},{"ayah_number":51,"text_uthmani":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","juz":29,"page":568},{"ayah_number":52,"text_uthmani":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","juz":29,"page":568}]}