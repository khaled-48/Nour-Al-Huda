{"surah_id":84,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","juz":30,"page":589},{"ayah_number":2,"text_uthmani":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","juz":30,"page":589},{"ayah_number":3,"text_uthmani":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","juz":30,"page":589},{"ayah_number":4,"text_uthmani":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","juz":30,"page":589},{"ayah_number":5,"text_uthmani":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","juz":30,"page":589},{"ayah_number":6,"text_uthmani":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ","juz":30,"page":589},{"ayah_number":7,"text_uthmani":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ","juz":30,"page":589},{"ayah_number":8,"text_uthmani":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","juz":30,"page":589},{"ayah_number":9,"text_uthmani":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا","juz":30,"page":589},{"ayah_number":10,"text_uthmani":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","juz":30,"page":589},{"ayah_number":11,"text_uthmani":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا","juz":30,"page":589},{"ayah_number":12,"text_uthmani":"وَيَصْلَىٰ سَعِيرًا","juz":30,"page":589},{"ayah_number":13,"text_uthmani":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","juz":30,"page":589},{"ayah_number":14,"text_uthmani":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","juz":30,"page":589},{"ayah_number":15,"text_uthmani":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","juz":30,"page":589},{"ayah_number":16,"text_uthmani":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","juz":30,"page":589},{"ayah_number":17,"text_uthmani":"وَٱلَّيْلِ وَمَا وَسَقَ","juz":30,"page":589},{"ayah_number":18,"text_uthmani":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","juz":30,"page":589},{"ayah_number":19,"text_uthmani":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","juz":30,"page":589},{"ayah_number":20,"text_uthmani":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","juz":30,"page":589},{"ayah_number":21,"text_uthmani":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","juz":30,"page":589},{"ayah_number":22,"text_uthmani":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","juz":30,"page":589},{"ayah_number":23,"text_uthmani":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","juz":30,"page":589},{"ayah_number":24,"text_uthmani":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","juz":30,"page":589},{"ayah_number":25,"text_uthmani":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","juz":30,"page":589}]}