{"surah_id":82,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","juz":30,"page":587},{"ayah_number":2,"text_uthmani":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","juz":30,"page":587},{"ayah_number":3,"text_uthmani":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","juz":30,"page":587},{"ayah_number":4,"text_uthmani":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","juz":30,"page":587},{"ayah_number":5,"text_uthmani":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","juz":30,"page":587},{"ayah_number":6,"text_uthmani":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","juz":30,"page":587},{"ayah_number":7,"text_uthmani":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","juz":30,"page":587},{"ayah_number":8,"text_uthmani":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","juz":30,"page":587},{"ayah_number":9,"text_uthmani":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","juz":30,"page":587},{"ayah_number":10,"text_uthmani":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","juz":30,"page":587},{"ayah_number":11,"text_uthmani":"كِرَامًا كَـٰتِبِينَ","juz":30,"page":587},{"ayah_number":12,"text_uthmani":"يَعْلَمُونَ مَا تَفْعَلُونَ","juz":30,"page":587},{"ayah_number":13,"text_uthmani":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","juz":30,"page":587},{"ayah_number":14,"text_uthmani":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","juz":30,"page":587},{"ayah_number":15,"text_uthmani":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","juz":30,"page":587},{"ayah_number":16,"text_uthmani":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","juz":30,"page":587},{"ayah_number":17,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","juz":30,"page":587},{"ayah_number":18,"text_uthmani":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","juz":30,"page":587},{"ayah_number":19,"text_uthmani":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","juz":30,"page":587}]}