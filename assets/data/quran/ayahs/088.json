{"surah_id":88,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","juz":30,"page":592},{"ayah_number":2,"text_uthmani":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","juz":30,"page":592},{"ayah_number":3,"text_uthmani":"عَامِلَةٌ نَّاصِبَةٌ","juz":30,"page":592},{"ayah_number":4,"text_uthmani":"تَصْلَىٰ نَارًا حَامِيَةً","juz":30,"page":592},{"ayah_number":5,"text_uthmani":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","juz":30,"page":592},{"ayah_number":6,"text_uthmani":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","juz":30,"page":592},{"ayah_number":7,"text_uthmani":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","juz":30,"page":592},{"ayah_number":8,"text_uthmani":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","juz":30,"page":592},{"ayah_number":9,"text_uthmani":"لِّسَعْيِهَا رَاضِيَةٌ","juz":30,"page":592},{"ayah_number":10,"text_uthmani":"فِى جَنَّةٍ عَالِيَةٍ","juz":30,"page":592},{"ayah_number":11,"text_uthmani":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً","juz":30,"page":592},{"ayah_number":12,"text_uthmani":"فِيهَا عَيْنٌ جَارِيَةٌ","juz":30,"page":592},{"ayah_number":13,"text_uthmani":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","juz":30,"page":592},{"ayah_number":14,"text_uthmani":"وَأَكْوَابٌ مَّوْضُوعَةٌ","juz":30,"page":592},{"ayah_number":15,"text_uthmani":"وَنَمَارِقُ مَصْفُوفَةٌ","juz":30,"page":592},{"ayah_number":16,"text_uthmani":"وَزَرَابِىُّ مَبْثُوثَةٌ","juz":30,"page":592},{"ayah_number":17,"text_uthmani":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","juz":30,"page":592},{"ayah_number":18,"text_uthmani":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","juz":30,"page":592},{"ayah_number":19,"text_uthmani":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","juz":30,"page":592},{"ayah_number":20,"text_uthmani":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","juz":30,"page":592},{"ayah_number":21,"text_uthmani":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","juz":30,"page":592},{"ayah_number":22,"text_uthmani":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","juz":30,"page":592},{"ayah_number":23,"text_uthmani":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","juz":30,"page":592},{"ayah_number":24,"text_uthmani":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","juz":30,"page":592},{"ayah_number":25,"text_uthmani":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","juz":30,"page":592},{"ayah_number":26,"text_uthmani":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","juz":30,"page":592}]}