{"surah_id":26,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ طسٓمٓ","juz":19,"page":367},{"ayah_number":2,"text_uthmani":"تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْمُبِينِ","juz":19,"page":367},{"ayah_number":3,"text_uthmani":"لَعَلَّكَ بَـٰخِعٌ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ","juz":19,"page":367},{"ayah_number":4,"text_uthmani":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةً فَظَلَّتْ أَعْنَـٰقُهُمْ لَهَا خَـٰضِعِينَ","juz":19,"page":367},{"ayah_number":5,"text_uthmani":"وَمَا يَأْتِيهِم مِّن ذِكْرٍ مِّنَ ٱلرَّحْمَـٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ","juz":19,"page":367},{"ayah_number":6,"text_uthmani":"فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَـٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","juz":19,"page":367},{"ayah_number":7,"text_uthmani":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ","juz":19,"page":367},{"ayah_number":8,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":367},{"ayah_number":9,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":367},{"ayah_number":10,"text_uthmani":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّـٰلِمِينَ","juz":19,"page":367},{"ayah_number":11,"text_uthmani":"قَوْمَ فِرْعَوْنَ ۚ أَلَا يَتَّقُونَ","juz":19,"page":367},{"ayah_number":12,"text_uthmani":"قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ","juz":19,"page":367},{"ayah_number":13,"text_uthmani":"وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَـٰرُونَ","juz":19,"page":367},{"ayah_number":14,"text_uthmani":"وَلَهُمْ عَلَىَّ ذَنۢبٌ فَأَخَافُ أَن يَقْتُلُونِ","juz":19,"page":367},{"ayah_number":15,"text_uthmani":"قَالَ كَلَّا ۖ فَٱذْهَبَا بِـَٔايَـٰتِنَآ ۖ إِنَّا مَعَكُم مُّسْتَمِعُونَ","juz":19,"page":367},{"ayah_number":16,"text_uthmani":"فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":367},{"ayah_number":17,"text_uthmani":"أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ","juz":19,"page":367},{"ayah_number":18,"text_uthmani":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ","juz":19,"page":367},{"ayah_number":19,"text_uthmani":"وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَـٰفِرِينَ","juz":19,"page":367},{"ayah_number":20,"text_uthmani":"قَالَ فَعَلْتُهَآ إِذًا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ","juz":19,"page":368},{"ayah_number":21,"text_uthmani":"فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِى رَبِّى حُكْمًا وَجَعَلَنِى مِنَ ٱلْمُرْسَلِينَ","juz":19,"page":368},{"ayah_number":22,"text_uthmani":"وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَىَّ أَنْ عَبَّدتَّ بَنِىٓ إِسْرَٰٓءِيلَ","juz":19,"page":368},{"ayah_number":23,"text_uthmani":"قَالَ فِرْعَوْنُ وَمَا رَبُّ ٱلْعَـٰلَمِينَ","juz":19,"page":368},{"ayah_number":24,"text_uthmani":"قَالَ رَبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ","juz":19,"page":368},{"ayah_number":25,"text_uthmani":"قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَ","juz":19,"page":368},{"ayah_number":26,"text_uthmani":"قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","juz":19,"page":368},{"ayah_number":27,"text_uthmani":"قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِىٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌ","juz":19,"page":368},{"ayah_number":28,"text_uthmani":"قَالَ رَبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُمْ تَعْقِلُونَ","juz":19,"page":368},{"ayah_number":29,"text_uthmani":"قَالَ لَئِنِ ٱتَّخَذْتَ إِلَـٰهًا غَيْرِى لَأَجْعَلَنَّكَ مِنَ ٱلْمَسْجُونِينَ","juz":19,"page":368},{"ayah_number":30,"text_uthmani":"قَالَ أَوَلَوْ جِئْتُكَ بِشَىْءٍ مُّبِينٍ","juz":19,"page":368},{"ayah_number":31,"text_uthmani":"قَالَ فَأْتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","juz":19,"page":368},{"ayah_number":32,"text_uthmani":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ","juz":19,"page":368},{"ayah_number":33,"text_uthmani":"وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّـٰظِرِينَ","juz":19,"page":368},{"ayah_number":34,"text_uthmani":"قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَـٰذَا لَسَـٰحِرٌ عَلِيمٌ","juz":19,"page":368},{"ayah_number":35,"text_uthmani":"يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَ","juz":19,"page":368},{"ayah_number":36,"text_uthmani":"قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَٱبْعَثْ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ","juz":19,"page":368},{"ayah_number":37,"text_uthmani":"يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍ","juz":19,"page":368},{"ayah_number":38,"text_uthmani":"فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَـٰتِ يَوْمٍ مَّعْلُومٍ","juz":19,"page":368},{"ayah_number":39,"text_uthmani":"وَقِيلَ لِلنَّاسِ هَلْ أَنتُم مُّجْتَمِعُونَ","juz":19,"page":368},{"ayah_number":40,"text_uthmani":"لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ","juz":19,"page":369},{"ayah_number":41,"text_uthmani":"فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَـٰلِبِينَ","juz":19,"page":369},{"ayah_number":42,"text_uthmani":"قَالَ نَعَمْ وَإِنَّكُمْ إِذًا لَّمِنَ ٱلْمُقَرَّبِينَ","juz":19,"page":369},{"ayah_number":43,"text_uthmani":"قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ","juz":19,"page":369},{"ayah_number":44,"text_uthmani":"فَأَلْقَوْا۟ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ ٱلْغَـٰلِبُونَ","juz":19,"page":369},{"ayah_number":45,"text_uthmani":"فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ","juz":19,"page":369},{"ayah_number":46,"text_uthmani":"فَأُلْقِىَ ٱلسَّحَرَةُ سَـٰجِدِينَ","juz":19,"page":369},{"ayah_number":47,"text_uthmani":"قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":369},{"ayah_number":48,"text_uthmani":"رَبِّ مُوسَىٰ وَهَـٰرُونَ","juz":19,"page":369},{"ayah_number":49,"text_uthmani":"قَالَ ءَامَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْ ۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ فَلَسَوْفَ تَعْلَمُونَ ۚ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَـٰفٍ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ","juz":19,"page":369},{"ayah_number":50,"text_uthmani":"قَالُوا۟ لَا ضَيْرَ ۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ","juz":19,"page":369},{"ayah_number":51,"text_uthmani":"إِنَّا نَطْمَعُ أَن يَغْفِرَ لَنَا رَبُّنَا خَطَـٰيَـٰنَآ أَن كُنَّآ أَوَّلَ ٱلْمُؤْمِنِينَ","juz":19,"page":369},{"ayah_number":52,"text_uthmani":"وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَسْرِ بِعِبَادِىٓ إِنَّكُم مُّتَّبَعُونَ","juz":19,"page":369},{"ayah_number":53,"text_uthmani":"فَأَرْسَلَ فِرْعَوْنُ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ","juz":19,"page":369},{"ayah_number":54,"text_uthmani":"إِنَّ هَـٰٓؤُلَآءِ لَشِرْذِمَةٌ قَلِيلُونَ","juz":19,"page":369},{"ayah_number":55,"text_uthmani":"وَإِنَّهُمْ لَنَا لَغَآئِظُونَ","juz":19,"page":369},{"ayah_number":56,"text_uthmani":"وَإِنَّا لَجَمِيعٌ حَـٰذِرُونَ","juz":19,"page":369},{"ayah_number":57,"text_uthmani":"فَأَخْرَجْنَـٰهُم مِّن جَنَّـٰتٍ وَعُيُونٍ","juz":19,"page":369},{"ayah_number":58,"text_uthmani":"وَكُنُوزٍ وَمَقَامٍ كَرِيمٍ","juz":19,"page":369},{"ayah_number":59,"text_uthmani":"كَذَٰلِكَ وَأَوْرَثْنَـٰهَا بَنِىٓ إِسْرَٰٓءِيلَ","juz":19,"page":369},{"ayah_number":60,"text_uthmani":"فَأَتْبَعُوهُم مُّشْرِقِينَ","juz":19,"page":369},{"ayah_number":61,"text_uthmani":"فَلَمَّا تَرَٰٓءَا ٱلْجَمْعَانِ قَالَ أَصْحَـٰبُ مُوسَىٰٓ إِنَّا لَمُدْرَكُونَ","juz":19,"page":370},{"ayah_number":62,"text_uthmani":"قَالَ كَلَّآ ۖ إِنَّ مَعِىَ رَبِّى سَيَهْدِينِ","juz":19,"page":370},{"ayah_number":63,"text_uthmani":"فَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْبَحْرَ ۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرْقٍ كَٱلطَّوْدِ ٱلْعَظِيمِ","juz":19,"page":370},{"ayah_number":64,"text_uthmani":"وَأَزْلَفْنَا ثَمَّ ٱلْـَٔاخَرِينَ","juz":19,"page":370},{"ayah_number":65,"text_uthmani":"وَأَنجَيْنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجْمَعِينَ","juz":19,"page":370},{"ayah_number":66,"text_uthmani":"ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ","juz":19,"page":370},{"ayah_number":67,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":370},{"ayah_number":68,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":370},{"ayah_number":69,"text_uthmani":"وَٱتْلُ عَلَيْهِمْ نَبَأَ إِبْرَٰهِيمَ","juz":19,"page":370},{"ayah_number":70,"text_uthmani":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَ","juz":19,"page":370},{"ayah_number":71,"text_uthmani":"قَالُوا۟ نَعْبُدُ أَصْنَامًا فَنَظَلُّ لَهَا عَـٰكِفِينَ","juz":19,"page":370},{"ayah_number":72,"text_uthmani":"قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ","juz":19,"page":370},{"ayah_number":73,"text_uthmani":"أَوْ يَنفَعُونَكُمْ أَوْ يَضُرُّونَ","juz":19,"page":370},{"ayah_number":74,"text_uthmani":"قَالُوا۟ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَ","juz":19,"page":370},{"ayah_number":75,"text_uthmani":"قَالَ أَفَرَءَيْتُم مَّا كُنتُمْ تَعْبُدُونَ","juz":19,"page":370},{"ayah_number":76,"text_uthmani":"أَنتُمْ وَءَابَآؤُكُمُ ٱلْأَقْدَمُونَ","juz":19,"page":370},{"ayah_number":77,"text_uthmani":"فَإِنَّهُمْ عَدُوٌّ لِّىٓ إِلَّا رَبَّ ٱلْعَـٰلَمِينَ","juz":19,"page":370},{"ayah_number":78,"text_uthmani":"ٱلَّذِى خَلَقَنِى فَهُوَ يَهْدِينِ","juz":19,"page":370},{"ayah_number":79,"text_uthmani":"وَٱلَّذِى هُوَ يُطْعِمُنِى وَيَسْقِينِ","juz":19,"page":370},{"ayah_number":80,"text_uthmani":"وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ","juz":19,"page":370},{"ayah_number":81,"text_uthmani":"وَٱلَّذِى يُمِيتُنِى ثُمَّ يُحْيِينِ","juz":19,"page":370},{"ayah_number":82,"text_uthmani":"وَٱلَّذِىٓ أَطْمَعُ أَن يَغْفِرَ لِى خَطِيٓـَٔتِى يَوْمَ ٱلدِّينِ","juz":19,"page":370},{"ayah_number":83,"text_uthmani":"رَبِّ هَبْ لِى حُكْمًا وَأَلْحِقْنِى بِٱلصَّـٰلِحِينَ","juz":19,"page":370},{"ayah_number":84,"text_uthmani":"وَٱجْعَل لِّى لِسَانَ صِدْقٍ فِى ٱلْـَٔاخِرِينَ","juz":19,"page":371},{"ayah_number":85,"text_uthmani":"وَٱجْعَلْنِى مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ","juz":19,"page":371},{"ayah_number":86,"text_uthmani":"وَٱغْفِرْ لِأَبِىٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ","juz":19,"page":371},{"ayah_number":87,"text_uthmani":"وَلَا تُخْزِنِى يَوْمَ يُبْعَثُونَ","juz":19,"page":371},{"ayah_number":88,"text_uthmani":"يَوْمَ لَا يَنفَعُ مَالٌ وَلَا بَنُونَ","juz":19,"page":371},{"ayah_number":89,"text_uthmani":"إِلَّا مَنْ أَتَى ٱللَّهَ بِقَلْبٍ سَلِيمٍ","juz":19,"page":371},{"ayah_number":90,"text_uthmani":"وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ","juz":19,"page":371},{"ayah_number":91,"text_uthmani":"وَبُرِّزَتِ ٱلْجَحِيمُ لِلْغَاوِينَ","juz":19,"page":371},{"ayah_number":92,"text_uthmani":"وَقِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ","juz":19,"page":371},{"ayah_number":93,"text_uthmani":"مِن دُونِ ٱللَّهِ هَلْ يَنصُرُونَكُمْ أَوْ يَنتَصِرُونَ","juz":19,"page":371},{"ayah_number":94,"text_uthmani":"فَكُبْكِبُوا۟ فِيهَا هُمْ وَٱلْغَاوُۥنَ","juz":19,"page":371},{"ayah_number":95,"text_uthmani":"وَجُنُودُ إِبْلِيسَ أَجْمَعُونَ","juz":19,"page":371},{"ayah_number":96,"text_uthmani":"قَالُوا۟ وَهُمْ فِيهَا يَخْتَصِمُونَ","juz":19,"page":371},{"ayah_number":97,"text_uthmani":"تَٱللَّهِ إِن كُنَّا لَفِى ضَلَـٰلٍ مُّبِينٍ","juz":19,"page":371},{"ayah_number":98,"text_uthmani":"إِذْ نُسَوِّيكُم بِرَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":371},{"ayah_number":99,"text_uthmani":"وَمَآ أَضَلَّنَآ إِلَّا ٱلْمُجْرِمُونَ","juz":19,"page":371},{"ayah_number":100,"text_uthmani":"فَمَا لَنَا مِن شَـٰفِعِينَ","juz":19,"page":371},{"ayah_number":101,"text_uthmani":"وَلَا صَدِيقٍ حَمِيمٍ","juz":19,"page":371},{"ayah_number":102,"text_uthmani":"فَلَوْ أَنَّ لَنَا كَرَّةً فَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ","juz":19,"page":371},{"ayah_number":103,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":371},{"ayah_number":104,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":371},{"ayah_number":105,"text_uthmani":"كَذَّبَتْ قَوْمُ نُوحٍ ٱلْمُرْسَلِينَ","juz":19,"page":371},{"ayah_number":106,"text_uthmani":"إِذْ قَالَ لَهُمْ أَخُوهُمْ نُوحٌ أَلَا تَتَّقُونَ","juz":19,"page":371},{"ayah_number":107,"text_uthmani":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","juz":19,"page":371},{"ayah_number":108,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":371},{"ayah_number":109,"text_uthmani":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":371},{"ayah_number":110,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":371},{"ayah_number":111,"text_uthmani":"قَالُوٓا۟ أَنُؤْمِنُ لَكَ وَٱتَّبَعَكَ ٱلْأَرْذَلُونَ","juz":19,"page":371},{"ayah_number":112,"text_uthmani":"قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ","juz":19,"page":372},{"ayah_number":113,"text_uthmani":"إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى ۖ لَوْ تَشْعُرُونَ","juz":19,"page":372},{"ayah_number":114,"text_uthmani":"وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ","juz":19,"page":372},{"ayah_number":115,"text_uthmani":"إِنْ أَنَا۠ إِلَّا نَذِيرٌ مُّبِينٌ","juz":19,"page":372},{"ayah_number":116,"text_uthmani":"قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَـٰنُوحُ لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ","juz":19,"page":372},{"ayah_number":117,"text_uthmani":"قَالَ رَبِّ إِنَّ قَوْمِى كَذَّبُونِ","juz":19,"page":372},{"ayah_number":118,"text_uthmani":"فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْحًا وَنَجِّنِى وَمَن مَّعِىَ مِنَ ٱلْمُؤْمِنِينَ","juz":19,"page":372},{"ayah_number":119,"text_uthmani":"فَأَنجَيْنَـٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ","juz":19,"page":372},{"ayah_number":120,"text_uthmani":"ثُمَّ أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ","juz":19,"page":372},{"ayah_number":121,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":372},{"ayah_number":122,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":372},{"ayah_number":123,"text_uthmani":"كَذَّبَتْ عَادٌ ٱلْمُرْسَلِينَ","juz":19,"page":372},{"ayah_number":124,"text_uthmani":"إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ","juz":19,"page":372},{"ayah_number":125,"text_uthmani":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","juz":19,"page":372},{"ayah_number":126,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":372},{"ayah_number":127,"text_uthmani":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":372},{"ayah_number":128,"text_uthmani":"أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةً تَعْبَثُونَ","juz":19,"page":372},{"ayah_number":129,"text_uthmani":"وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ","juz":19,"page":372},{"ayah_number":130,"text_uthmani":"وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ","juz":19,"page":372},{"ayah_number":131,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":372},{"ayah_number":132,"text_uthmani":"وَٱتَّقُوا۟ ٱلَّذِىٓ أَمَدَّكُم بِمَا تَعْلَمُونَ","juz":19,"page":372},{"ayah_number":133,"text_uthmani":"أَمَدَّكُم بِأَنْعَـٰمٍ وَبَنِينَ","juz":19,"page":372},{"ayah_number":134,"text_uthmani":"وَجَنَّـٰتٍ وَعُيُونٍ","juz":19,"page":372},{"ayah_number":135,"text_uthmani":"إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ","juz":19,"page":372},{"ayah_number":136,"text_uthmani":"قَالُوا۟ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ ٱلْوَٰعِظِينَ","juz":19,"page":372},{"ayah_number":137,"text_uthmani":"إِنْ هَـٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ","juz":19,"page":373},{"ayah_number":138,"text_uthmani":"وَمَا نَحْنُ بِمُعَذَّبِينَ","juz":19,"page":373},{"ayah_number":139,"text_uthmani":"فَكَذَّبُوهُ فَأَهْلَكْنَـٰهُمْ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":373},{"ayah_number":140,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":373},{"ayah_number":141,"text_uthmani":"كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ","juz":19,"page":373},{"ayah_number":142,"text_uthmani":"إِذْ قَالَ لَهُمْ أَخُوهُمْ صَـٰلِحٌ أَلَا تَتَّقُونَ","juz":19,"page":373},{"ayah_number":143,"text_uthmani":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","juz":19,"page":373},{"ayah_number":144,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":373},{"ayah_number":145,"text_uthmani":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":373},{"ayah_number":146,"text_uthmani":"أَتُتْرَكُونَ فِى مَا هَـٰهُنَآ ءَامِنِينَ","juz":19,"page":373},{"ayah_number":147,"text_uthmani":"فِى جَنَّـٰتٍ وَعُيُونٍ","juz":19,"page":373},{"ayah_number":148,"text_uthmani":"وَزُرُوعٍ وَنَخْلٍ طَلْعُهَا هَضِيمٌ","juz":19,"page":373},{"ayah_number":149,"text_uthmani":"وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا فَـٰرِهِينَ","juz":19,"page":373},{"ayah_number":150,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":373},{"ayah_number":151,"text_uthmani":"وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ","juz":19,"page":373},{"ayah_number":152,"text_uthmani":"ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ","juz":19,"page":373},{"ayah_number":153,"text_uthmani":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ","juz":19,"page":373},{"ayah_number":154,"text_uthmani":"مَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","juz":19,"page":373},{"ayah_number":155,"text_uthmani":"قَالَ هَـٰذِهِۦ نَاقَةٌ لَّهَا شِرْبٌ وَلَكُمْ شِرْبُ يَوْمٍ مَّعْلُومٍ","juz":19,"page":373},{"ayah_number":156,"text_uthmani":"وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٍ","juz":19,"page":373},{"ayah_number":157,"text_uthmani":"فَعَقَرُوهَا فَأَصْبَحُوا۟ نَـٰدِمِينَ","juz":19,"page":373},{"ayah_number":158,"text_uthmani":"فَأَخَذَهُمُ ٱلْعَذَابُ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":373},{"ayah_number":159,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":373},{"ayah_number":160,"text_uthmani":"كَذَّبَتْ قَوْمُ لُوطٍ ٱلْمُرْسَلِينَ","juz":19,"page":374},{"ayah_number":161,"text_uthmani":"إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّقُونَ","juz":19,"page":374},{"ayah_number":162,"text_uthmani":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","juz":19,"page":374},{"ayah_number":163,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":374},{"ayah_number":164,"text_uthmani":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":374},{"ayah_number":165,"text_uthmani":"أَتَأْتُونَ ٱلذُّكْرَانَ مِنَ ٱلْعَـٰلَمِينَ","juz":19,"page":374},{"ayah_number":166,"text_uthmani":"وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنْ أَزْوَٰجِكُم ۚ بَلْ أَنتُمْ قَوْمٌ عَادُونَ","juz":19,"page":374},{"ayah_number":167,"text_uthmani":"قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَـٰلُوطُ لَتَكُونَنَّ مِنَ ٱلْمُخْرَجِينَ","juz":19,"page":374},{"ayah_number":168,"text_uthmani":"قَالَ إِنِّى لِعَمَلِكُم مِّنَ ٱلْقَالِينَ","juz":19,"page":374},{"ayah_number":169,"text_uthmani":"رَبِّ نَجِّنِى وَأَهْلِى مِمَّا يَعْمَلُونَ","juz":19,"page":374},{"ayah_number":170,"text_uthmani":"فَنَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ","juz":19,"page":374},{"ayah_number":171,"text_uthmani":"إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ","juz":19,"page":374},{"ayah_number":172,"text_uthmani":"ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ","juz":19,"page":374},{"ayah_number":173,"text_uthmani":"وَأَمْطَرْنَا عَلَيْهِم مَّطَرًا ۖ فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ","juz":19,"page":374},{"ayah_number":174,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":374},{"ayah_number":175,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":374},{"ayah_number":176,"text_uthmani":"كَذَّبَ أَصْحَـٰبُ لْـَٔيْكَةِ ٱلْمُرْسَلِينَ","juz":19,"page":374},{"ayah_number":177,"text_uthmani":"إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ","juz":19,"page":374},{"ayah_number":178,"text_uthmani":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","juz":19,"page":374},{"ayah_number":179,"text_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","juz":19,"page":374},{"ayah_number":180,"text_uthmani":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":374},{"ayah_number":181,"text_uthmani":"أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ","juz":19,"page":374},{"ayah_number":182,"text_uthmani":"وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ","juz":19,"page":374},{"ayah_number":183,"text_uthmani":"وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ","juz":19,"page":374},{"ayah_number":184,"text_uthmani":"وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ","juz":19,"page":375},{"ayah_number":185,"text_uthmani":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ","juz":19,"page":375},{"ayah_number":186,"text_uthmani":"وَمَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَـٰذِبِينَ","juz":19,"page":375},{"ayah_number":187,"text_uthmani":"فَأَسْقِطْ عَلَيْنَا كِسَفًا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","juz":19,"page":375},{"ayah_number":188,"text_uthmani":"قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ","juz":19,"page":375},{"ayah_number":189,"text_uthmani":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ","juz":19,"page":375},{"ayah_number":190,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":375},{"ayah_number":191,"text_uthmani":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":375},{"ayah_number":192,"text_uthmani":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَـٰلَمِينَ","juz":19,"page":375},{"ayah_number":193,"text_uthmani":"نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ","juz":19,"page":375},{"ayah_number":194,"text_uthmani":"عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ ٱلْمُنذِرِينَ","juz":19,"page":375},{"ayah_number":195,"text_uthmani":"بِلِسَانٍ عَرَبِىٍّ مُّبِينٍ","juz":19,"page":375},{"ayah_number":196,"text_uthmani":"وَإِنَّهُۥ لَفِى زُبُرِ ٱلْأَوَّلِينَ","juz":19,"page":375},{"ayah_number":197,"text_uthmani":"أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَن يَعْلَمَهُۥ عُلَمَـٰٓؤُا۟ بَنِىٓ إِسْرَٰٓءِيلَ","juz":19,"page":375},{"ayah_number":198,"text_uthmani":"وَلَوْ نَزَّلْنَـٰهُ عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ","juz":19,"page":375},{"ayah_number":199,"text_uthmani":"فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُوا۟ بِهِۦ مُؤْمِنِينَ","juz":19,"page":375},{"ayah_number":200,"text_uthmani":"كَذَٰلِكَ سَلَكْنَـٰهُ فِى قُلُوبِ ٱلْمُجْرِمِينَ","juz":19,"page":375},{"ayah_number":201,"text_uthmani":"لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ","juz":19,"page":375},{"ayah_number":202,"text_uthmani":"فَيَأْتِيَهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ","juz":19,"page":375},{"ayah_number":203,"text_uthmani":"فَيَقُولُوا۟ هَلْ نَحْنُ مُنظَرُونَ","juz":19,"page":375},{"ayah_number":204,"text_uthmani":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","juz":19,"page":375},{"ayah_number":205,"text_uthmani":"أَفَرَءَيْتَ إِن مَّتَّعْنَـٰهُمْ سِنِينَ","juz":19,"page":375},{"ayah_number":206,"text_uthmani":"ثُمَّ جَآءَهُم مَّا كَانُوا۟ يُوعَدُونَ","juz":19,"page":375},{"ayah_number":207,"text_uthmani":"مَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يُمَتَّعُونَ","juz":19,"page":376},{"ayah_number":208,"text_uthmani":"وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ","juz":19,"page":376},{"ayah_number":209,"text_uthmani":"ذِكْرَىٰ وَمَا كُنَّا ظَـٰلِمِينَ","juz":19,"page":376},{"ayah_number":210,"text_uthmani":"وَمَا تَنَزَّلَتْ بِهِ ٱلشَّيَـٰطِينُ","juz":19,"page":376},{"ayah_number":211,"text_uthmani":"وَمَا يَنۢبَغِى لَهُمْ وَمَا يَسْتَطِيعُونَ","juz":19,"page":376},{"ayah_number":212,"text_uthmani":"إِنَّهُمْ عَنِ ٱلسَّمْعِ لَمَعْزُولُونَ","juz":19,"page":376},{"ayah_number":213,"text_uthmani":"فَلَا تَدْعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلْمُعَذَّبِينَ","juz":19,"page":376},{"ayah_number":214,"text_uthmani":"وَأَنذِرْ عَشِيرَتَكَ ٱلْأَقْرَبِينَ","juz":19,"page":376},{"ayah_number":215,"text_uthmani":"وَٱخْفِضْ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلْمُؤْمِنِينَ","juz":19,"page":376},{"ayah_number":216,"text_uthmani":"فَإِنْ عَصَوْكَ فَقُلْ إِنِّى بَرِىٓءٌ مِّمَّا تَعْمَلُونَ","juz":19,"page":376},{"ayah_number":217,"text_uthmani":"وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ","juz":19,"page":376},{"ayah_number":218,"text_uthmani":"ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ","juz":19,"page":376},{"ayah_number":219,"text_uthmani":"وَتَقَلُّبَكَ فِى ٱلسَّـٰجِدِينَ","juz":19,"page":376},{"ayah_number":220,"text_uthmani":"إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ","juz":19,"page":376},{"ayah_number":221,"text_uthmani":"هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَـٰطِينُ","juz":19,"page":376},{"ayah_number":222,"text_uthmani":"تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٍ","juz":19,"page":376},{"ayah_number":223,"text_uthmani":"يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَـٰذِبُونَ","juz":19,"page":376},{"ayah_number":224,"text_uthmani":"وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلْغَاوُۥنَ","juz":19,"page":376},{"ayah_number":225,"text_uthmani":"أَلَمْ تَرَ أَنَّهُمْ فِى كُلِّ وَادٍ يَهِيمُونَ","juz":19,"page":376},{"ayah_number":226,"text_uthmani":"وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَ","juz":19,"page":376},{"ayah_number":227,"text_uthmani":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَذَكَرُوا۟ ٱللَّهَ كَثِيرًا وَٱنتَصَرُوا۟ مِنۢ بَعْدِ مَا ظُلِمُوا۟ ۗ وَسَيَعْلَمُ ٱلَّذِينَ ظَلَمُوٓا۟ أَىَّ مُنقَلَبٍ يَنقَلِبُونَ","juz":19,"page":376}]}