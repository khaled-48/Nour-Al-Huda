{"surah_id":111,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","juz":30,"page":603},{"ayah_number":2,"text_uthmani":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","juz":30,"page":603},{"ayah_number":3,"text_uthmani":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","juz":30,"page":603},{"ayah_number":4,"text_uthmani":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","juz":30,"page":603},{"ayah_number":5,"text_uthmani":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ","juz":30,"page":603}]}