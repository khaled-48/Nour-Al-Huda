{"surah_id":78,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ","juz":30,"page":582},{"ayah_number":2,"text_uthmani":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","juz":30,"page":582},{"ayah_number":3,"text_uthmani":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","juz":30,"page":582},{"ayah_number":4,"text_uthmani":"كَلَّا سَيَعْلَمُونَ","juz":30,"page":582},{"ayah_number":5,"text_uthmani":"ثُمَّ كَلَّا سَيَعْلَمُونَ","juz":30,"page":582},{"ayah_number":6,"text_uthmani":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا","juz":30,"page":582},{"ayah_number":7,"text_uthmani":"وَٱلْجِبَالَ أَوْتَادًا","juz":30,"page":582},{"ayah_number":8,"text_uthmani":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا","juz":30,"page":582},{"ayah_number":9,"text_uthmani":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","juz":30,"page":582},{"ayah_number":10,"text_uthmani":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","juz":30,"page":582},{"ayah_number":11,"text_uthmani":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","juz":30,"page":582},{"ayah_number":12,"text_uthmani":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","juz":30,"page":582},{"ayah_number":13,"text_uthmani":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","juz":30,"page":582},{"ayah_number":14,"text_uthmani":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","juz":30,"page":582},{"ayah_number":15,"text_uthmani":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","juz":30,"page":582},{"ayah_number":16,"text_uthmani":"وَجَنَّـٰتٍ أَلْفَافًا","juz":30,"page":582},{"ayah_number":17,"text_uthmani":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا","juz":30,"page":582},{"ayah_number":18,"text_uthmani":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","juz":30,"page":582},{"ayah_number":19,"text_uthmani":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","juz":30,"page":582},{"ayah_number":20,"text_uthmani":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","juz":30,"page":582},{"ayah_number":21,"text_uthmani":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","juz":30,"page":582},{"ayah_number":22,"text_uthmani":"لِّلطَّـٰغِينَ مَـَٔابًا","juz":30,"page":582},{"ayah_number":23,"text_uthmani":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا","juz":30,"page":582},{"ayah_number":24,"text_uthmani":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","juz":30,"page":582},{"ayah_number":25,"text_uthmani":"إِلَّا حَمِيمًا وَغَسَّاقًا","juz":30,"page":582},{"ayah_number":26,"text_uthmani":"جَزَآءً وِفَاقًا","juz":30,"page":582},{"ayah_number":27,"text_uthmani":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا","juz":30,"page":582},{"ayah_number":28,"text_uthmani":"وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا","juz":30,"page":582},{"ayah_number":29,"text_uthmani":"وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا","juz":30,"page":582},{"ayah_number":30,"text_uthmani":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","juz":30,"page":582},{"ayah_number":31,"text_uthmani":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","juz":30,"page":583},{"ayah_number":32,"text_uthmani":"حَدَآئِقَ وَأَعْنَـٰبًا","juz":30,"page":583},{"ayah_number":33,"text_uthmani":"وَكَوَاعِبَ أَتْرَابًا","juz":30,"page":583},{"ayah_number":34,"text_uthmani":"وَكَأْسًا دِهَاقًا","juz":30,"page":583},{"ayah_number":35,"text_uthmani":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","juz":30,"page":583},{"ayah_number":36,"text_uthmani":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","juz":30,"page":583},{"ayah_number":37,"text_uthmani":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","juz":30,"page":583},{"ayah_number":38,"text_uthmani":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا","juz":30,"page":583},{"ayah_number":39,"text_uthmani":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","juz":30,"page":583},{"ayah_number":40,"text_uthmani":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا","juz":30,"page":583}]}