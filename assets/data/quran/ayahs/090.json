{"surah_id":90,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ","juz":30,"page":594},{"ayah_number":2,"text_uthmani":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ","juz":30,"page":594},{"ayah_number":3,"text_uthmani":"وَوَالِدٍ وَمَا وَلَدَ","juz":30,"page":594},{"ayah_number":4,"text_uthmani":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ","juz":30,"page":594},{"ayah_number":5,"text_uthmani":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ","juz":30,"page":594},{"ayah_number":6,"text_uthmani":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا","juz":30,"page":594},{"ayah_number":7,"text_uthmani":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","juz":30,"page":594},{"ayah_number":8,"text_uthmani":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","juz":30,"page":594},{"ayah_number":9,"text_uthmani":"وَلِسَانًا وَشَفَتَيْنِ","juz":30,"page":594},{"ayah_number":10,"text_uthmani":"وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ","juz":30,"page":594},{"ayah_number":11,"text_uthmani":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","juz":30,"page":594},{"ayah_number":12,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","juz":30,"page":594},{"ayah_number":13,"text_uthmani":"فَكُّ رَقَبَةٍ","juz":30,"page":594},{"ayah_number":14,"text_uthmani":"أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ","juz":30,"page":594},{"ayah_number":15,"text_uthmani":"يَتِيمًا ذَا مَقْرَبَةٍ","juz":30,"page":594},{"ayah_number":16,"text_uthmani":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","juz":30,"page":594},{"ayah_number":17,"text_uthmani":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","juz":30,"page":594},{"ayah_number":18,"text_uthmani":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ","juz":30,"page":594},{"ayah_number":19,"text_uthmani":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","juz":30,"page":594},{"ayah_number":20,"text_uthmani":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ","juz":30,"page":594}]}