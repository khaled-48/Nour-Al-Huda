{"surah_id":79,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلنَّـٰزِعَـٰتِ غَرْقًا","juz":30,"page":583},{"ayah_number":2,"text_uthmani":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا","juz":30,"page":583},{"ayah_number":3,"text_uthmani":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا","juz":30,"page":583},{"ayah_number":4,"text_uthmani":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا","juz":30,"page":583},{"ayah_number":5,"text_uthmani":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","juz":30,"page":583},{"ayah_number":6,"text_uthmani":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","juz":30,"page":583},{"ayah_number":7,"text_uthmani":"تَتْبَعُهَا ٱلرَّادِفَةُ","juz":30,"page":583},{"ayah_number":8,"text_uthmani":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","juz":30,"page":583},{"ayah_number":9,"text_uthmani":"أَبْصَـٰرُهَا خَـٰشِعَةٌ","juz":30,"page":583},{"ayah_number":10,"text_uthmani":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","juz":30,"page":583},{"ayah_number":11,"text_uthmani":"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً","juz":30,"page":583},{"ayah_number":12,"text_uthmani":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","juz":30,"page":583},{"ayah_number":13,"text_uthmani":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","juz":30,"page":583},{"ayah_number":14,"text_uthmani":"فَإِذَا هُم بِٱلسَّاهِرَةِ","juz":30,"page":583},{"ayah_number":15,"text_uthmani":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","juz":30,"page":583},{"ayah_number":16,"text_uthmani":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","juz":30,"page":584},{"ayah_number":17,"text_uthmani":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","juz":30,"page":584},{"ayah_number":18,"text_uthmani":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","juz":30,"page":584},{"ayah_number":19,"text_uthmani":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","juz":30,"page":584},{"ayah_number":20,"text_uthmani":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ","juz":30,"page":584},{"ayah_number":21,"text_uthmani":"فَكَذَّبَ وَعَصَىٰ","juz":30,"page":584},{"ayah_number":22,"text_uthmani":"ثُمَّ أَدْبَرَ يَسْعَىٰ","juz":30,"page":584},{"ayah_number":23,"text_uthmani":"فَحَشَرَ فَنَادَىٰ","juz":30,"page":584},{"ayah_number":24,"text_uthmani":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","juz":30,"page":584},{"ayah_number":25,"text_uthmani":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ","juz":30,"page":584},{"ayah_number":26,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ","juz":30,"page":584},{"ayah_number":27,"text_uthmani":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","juz":30,"page":584},{"ayah_number":28,"text_uthmani":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","juz":30,"page":584},{"ayah_number":29,"text_uthmani":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","juz":30,"page":584},{"ayah_number":30,"text_uthmani":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","juz":30,"page":584},{"ayah_number":31,"text_uthmani":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","juz":30,"page":584},{"ayah_number":32,"text_uthmani":"وَٱلْجِبَالَ أَرْسَىٰهَا","juz":30,"page":584},{"ayah_number":33,"text_uthmani":"مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","juz":30,"page":584},{"ayah_number":34,"text_uthmani":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","juz":30,"page":584},{"ayah_number":35,"text_uthmani":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ","juz":30,"page":584},{"ayah_number":36,"text_uthmani":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","juz":30,"page":584},{"ayah_number":37,"text_uthmani":"فَأَمَّا مَن طَغَىٰ","juz":30,"page":584},{"ayah_number":38,"text_uthmani":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","juz":30,"page":584},{"ayah_number":39,"text_uthmani":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","juz":30,"page":584},{"ayah_number":40,"text_uthmani":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","juz":30,"page":584},{"ayah_number":41,"text_uthmani":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","juz":30,"page":584},{"ayah_number":42,"text_uthmani":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","juz":30,"page":584},{"ayah_number":43,"text_uthmani":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","juz":30,"page":584},{"ayah_number":44,"text_uthmani":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","juz":30,"page":584},{"ayah_number":45,"text_uthmani":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","juz":30,"page":584},{"ayah_number":46,"text_uthmani":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","juz":30,"page":584}]}