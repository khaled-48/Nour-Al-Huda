{"surah_id":101,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","juz":30,"page":600},{"ayah_number":2,"text_uthmani":"مَا ٱلْقَارِعَةُ","juz":30,"page":600},{"ayah_number":3,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","juz":30,"page":600},{"ayah_number":4,"text_uthmani":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","juz":30,"page":600},{"ayah_number":5,"text_uthmani":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","juz":30,"page":600},{"ayah_number":6,"text_uthmani":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","juz":30,"page":600},{"ayah_number":7,"text_uthmani":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","juz":30,"page":600},{"ayah_number":8,"text_uthmani":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","juz":30,"page":600},{"ayah_number":9,"text_uthmani":"فَأُمُّهُۥ هَاوِيَةٌ","juz":30,"page":600},{"ayah_number":10,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","juz":30,"page":600},{"ayah_number":11,"text_uthmani":"نَارٌ حَامِيَةٌۢ","juz":30,"page":600}]}