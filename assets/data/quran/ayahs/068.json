{"surah_id":68,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","juz":29,"page":564},{"ayah_number":2,"text_uthmani":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","juz":29,"page":564},{"ayah_number":3,"text_uthmani":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","juz":29,"page":564},{"ayah_number":4,"text_uthmani":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","juz":29,"page":564},{"ayah_number":5,"text_uthmani":"فَسَتُبْصِرُ وَيُبْصِرُونَ","juz":29,"page":564},{"ayah_number":6,"text_uthmani":"بِأَييِّكُمُ ٱلْمَفْتُونُ","juz":29,"page":564},{"ayah_number":7,"text_uthmani":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","juz":29,"page":564},{"ayah_number":8,"text_uthmani":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","juz":29,"page":564},{"ayah_number":9,"text_uthmani":"وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ","juz":29,"page":564},{"ayah_number":10,"text_uthmani":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ","juz":29,"page":564},{"ayah_number":11,"text_uthmani":"هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ","juz":29,"page":564},{"ayah_number":12,"text_uthmani":"مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","juz":29,"page":564},{"ayah_number":13,"text_uthmani":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","juz":29,"page":564},{"ayah_number":14,"text_uthmani":"أَن كَانَ ذَا مَالٍ وَبَنِينَ","juz":29,"page":564},{"ayah_number":15,"text_uthmani":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","juz":29,"page":564},{"ayah_number":16,"text_uthmani":"سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ","juz":29,"page":565},{"ayah_number":17,"text_uthmani":"إِنَّا بَلَوْنَـٰهُمْ كَمَا بَلَوْنَآ أَصْحَـٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ","juz":29,"page":565},{"ayah_number":18,"text_uthmani":"وَلَا يَسْتَثْنُونَ","juz":29,"page":565},{"ayah_number":19,"text_uthmani":"فَطَافَ عَلَيْهَا طَآئِفٌ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ","juz":29,"page":565},{"ayah_number":20,"text_uthmani":"فَأَصْبَحَتْ كَٱلصَّرِيمِ","juz":29,"page":565},{"ayah_number":21,"text_uthmani":"فَتَنَادَوْا۟ مُصْبِحِينَ","juz":29,"page":565},{"ayah_number":22,"text_uthmani":"أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَـٰرِمِينَ","juz":29,"page":565},{"ayah_number":23,"text_uthmani":"فَٱنطَلَقُوا۟ وَهُمْ يَتَخَـٰفَتُونَ","juz":29,"page":565},{"ayah_number":24,"text_uthmani":"أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ","juz":29,"page":565},{"ayah_number":25,"text_uthmani":"وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَـٰدِرِينَ","juz":29,"page":565},{"ayah_number":26,"text_uthmani":"فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ","juz":29,"page":565},{"ayah_number":27,"text_uthmani":"بَلْ نَحْنُ مَحْرُومُونَ","juz":29,"page":565},{"ayah_number":28,"text_uthmani":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ","juz":29,"page":565},{"ayah_number":29,"text_uthmani":"قَالُوا۟ سُبْحَـٰنَ رَبِّنَآ إِنَّا كُنَّا ظَـٰلِمِينَ","juz":29,"page":565},{"ayah_number":30,"text_uthmani":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَـٰوَمُونَ","juz":29,"page":565},{"ayah_number":31,"text_uthmani":"قَالُوا۟ يَـٰوَيْلَنَآ إِنَّا كُنَّا طَـٰغِينَ","juz":29,"page":565},{"ayah_number":32,"text_uthmani":"عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ","juz":29,"page":565},{"ayah_number":33,"text_uthmani":"كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ","juz":29,"page":565},{"ayah_number":34,"text_uthmani":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّـٰتِ ٱلنَّعِيمِ","juz":29,"page":565},{"ayah_number":35,"text_uthmani":"أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ","juz":29,"page":565},{"ayah_number":36,"text_uthmani":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","juz":29,"page":565},{"ayah_number":37,"text_uthmani":"أَمْ لَكُمْ كِتَـٰبٌ فِيهِ تَدْرُسُونَ","juz":29,"page":565},{"ayah_number":38,"text_uthmani":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","juz":29,"page":565},{"ayah_number":39,"text_uthmani":"أَمْ لَكُمْ أَيْمَـٰنٌ عَلَيْنَا بَـٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ","juz":29,"page":565},{"ayah_number":40,"text_uthmani":"سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ","juz":29,"page":565},{"ayah_number":41,"text_uthmani":"أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَـٰدِقِينَ","juz":29,"page":565},{"ayah_number":42,"text_uthmani":"يَوْمَ يُكْشَفُ عَن سَاقٍ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ","juz":29,"page":565},{"ayah_number":43,"text_uthmani":"خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَـٰلِمُونَ","juz":29,"page":566},{"ayah_number":44,"text_uthmani":"فَذَرْنِى وَمَن يُكَذِّبُ بِهَـٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ","juz":29,"page":566},{"ayah_number":45,"text_uthmani":"وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ","juz":29,"page":566},{"ayah_number":46,"text_uthmani":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","juz":29,"page":566},{"ayah_number":47,"text_uthmani":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","juz":29,"page":566},{"ayah_number":48,"text_uthmani":"فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ","juz":29,"page":566},{"ayah_number":49,"text_uthmani":"لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ","juz":29,"page":566},{"ayah_number":50,"text_uthmani":"فَٱجْتَبَـٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّـٰلِحِينَ","juz":29,"page":566},{"ayah_number":51,"text_uthmani":"وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَـٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ","juz":29,"page":566},{"ayah_number":52,"text_uthmani":"وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","juz":29,"page":566}]}