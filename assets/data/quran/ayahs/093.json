{"surah_id":93,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","juz":30,"page":596},{"ayah_number":2,"text_uthmani":"وَٱلَّيْلِ إِذَا سَجَىٰ","juz":30,"page":596},{"ayah_number":3,"text_uthmani":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","juz":30,"page":596},{"ayah_number":4,"text_uthmani":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","juz":30,"page":596},{"ayah_number":5,"text_uthmani":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","juz":30,"page":596},{"ayah_number":6,"text_uthmani":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","juz":30,"page":596},{"ayah_number":7,"text_uthmani":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","juz":30,"page":596},{"ayah_number":8,"text_uthmani":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","juz":30,"page":596},{"ayah_number":9,"text_uthmani":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","juz":30,"page":596},{"ayah_number":10,"text_uthmani":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","juz":30,"page":596},{"ayah_number":11,"text_uthmani":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","juz":30,"page":596}]}