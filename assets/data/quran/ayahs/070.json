{"surah_id":70,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ","juz":29,"page":568},{"ayah_number":2,"text_uthmani":"لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ","juz":29,"page":568},{"ayah_number":3,"text_uthmani":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","juz":29,"page":568},{"ayah_number":4,"text_uthmani":"تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ","juz":29,"page":568},{"ayah_number":5,"text_uthmani":"فَٱصْبِرْ صَبْرًا جَمِيلًا","juz":29,"page":568},{"ayah_number":6,"text_uthmani":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا","juz":29,"page":568},{"ayah_number":7,"text_uthmani":"وَنَرَىٰهُ قَرِيبًا","juz":29,"page":568},{"ayah_number":8,"text_uthmani":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","juz":29,"page":568},{"ayah_number":9,"text_uthmani":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","juz":29,"page":568},{"ayah_number":10,"text_uthmani":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا","juz":29,"page":568},{"ayah_number":11,"text_uthmani":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","juz":29,"page":569},{"ayah_number":12,"text_uthmani":"وَصَـٰحِبَتِهِۦ وَأَخِيهِ","juz":29,"page":569},{"ayah_number":13,"text_uthmani":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","juz":29,"page":569},{"ayah_number":14,"text_uthmani":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ","juz":29,"page":569},{"ayah_number":15,"text_uthmani":"كَلَّآ ۖ إِنَّهَا لَظَىٰ","juz":29,"page":569},{"ayah_number":16,"text_uthmani":"نَزَّاعَةً لِّلشَّوَىٰ","juz":29,"page":569},{"ayah_number":17,"text_uthmani":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","juz":29,"page":569},{"ayah_number":18,"text_uthmani":"وَجَمَعَ فَأَوْعَىٰٓ","juz":29,"page":569},{"ayah_number":19,"text_uthmani":"إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا","juz":29,"page":569},{"ayah_number":20,"text_uthmani":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","juz":29,"page":569},{"ayah_number":21,"text_uthmani":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","juz":29,"page":569},{"ayah_number":22,"text_uthmani":"إِلَّا ٱلْمُصَلِّينَ","juz":29,"page":569},{"ayah_number":23,"text_uthmani":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","juz":29,"page":569},{"ayah_number":24,"text_uthmani":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ","juz":29,"page":569},{"ayah_number":25,"text_uthmani":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","juz":29,"page":569},{"ayah_number":26,"text_uthmani":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","juz":29,"page":569},{"ayah_number":27,"text_uthmani":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","juz":29,"page":569},{"ayah_number":28,"text_uthmani":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ","juz":29,"page":569},{"ayah_number":29,"text_uthmani":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ","juz":29,"page":569},{"ayah_number":30,"text_uthmani":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","juz":29,"page":569},{"ayah_number":31,"text_uthmani":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ","juz":29,"page":569},{"ayah_number":32,"text_uthmani":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","juz":29,"page":569},{"ayah_number":33,"text_uthmani":"وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ","juz":29,"page":569},{"ayah_number":34,"text_uthmani":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","juz":29,"page":569},{"ayah_number":35,"text_uthmani":"أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ","juz":29,"page":569},{"ayah_number":36,"text_uthmani":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ","juz":29,"page":569},{"ayah_number":37,"text_uthmani":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","juz":29,"page":569},{"ayah_number":38,"text_uthmani":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ","juz":29,"page":569},{"ayah_number":39,"text_uthmani":"كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ","juz":29,"page":569},{"ayah_number":40,"text_uthmani":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ","juz":29,"page":570},{"ayah_number":41,"text_uthmani":"عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ","juz":29,"page":570},{"ayah_number":42,"text_uthmani":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ","juz":29,"page":570},{"ayah_number":43,"text_uthmani":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ","juz":29,"page":570},{"ayah_number":44,"text_uthmani":"خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ","juz":29,"page":570}]}