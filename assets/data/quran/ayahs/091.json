{"surah_id":91,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا","juz":30,"page":595},{"ayah_number":2,"text_uthmani":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","juz":30,"page":595},{"ayah_number":3,"text_uthmani":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","juz":30,"page":595},{"ayah_number":4,"text_uthmani":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","juz":30,"page":595},{"ayah_number":5,"text_uthmani":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","juz":30,"page":595},{"ayah_number":6,"text_uthmani":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","juz":30,"page":595},{"ayah_number":7,"text_uthmani":"وَنَفْسٍ وَمَا سَوَّىٰهَا","juz":30,"page":595},{"ayah_number":8,"text_uthmani":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","juz":30,"page":595},{"ayah_number":9,"text_uthmani":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","juz":30,"page":595},{"ayah_number":10,"text_uthmani":"وَقَدْ خَابَ مَن دَسَّىٰهَا","juz":30,"page":595},{"ayah_number":11,"text_uthmani":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","juz":30,"page":595},{"ayah_number":12,"text_uthmani":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","juz":30,"page":595},{"ayah_number":13,"text_uthmani":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","juz":30,"page":595},{"ayah_number":14,"text_uthmani":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","juz":30,"page":595},{"ayah_number":15,"text_uthmani":"وَلَا يَخَافُ عُقْبَـٰهَا","juz":30,"page":595}]}