{"surah_id":37,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلصَّـٰٓفَّـٰتِ صَفًّا","juz":23,"page":446},{"ayah_number":2,"text_uthmani":"فَٱلزَّٰجِرَٰتِ زَجْرًا","juz":23,"page":446},{"ayah_number":3,"text_uthmani":"فَٱلتَّـٰلِيَـٰتِ ذِكْرًا","juz":23,"page":446},{"ayah_number":4,"text_uthmani":"إِنَّ إِلَـٰهَكُمْ لَوَٰحِدٌ","juz":23,"page":446},{"ayah_number":5,"text_uthmani":"رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَـٰرِقِ","juz":23,"page":446},{"ayah_number":6,"text_uthmani":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ","juz":23,"page":446},{"ayah_number":7,"text_uthmani":"وَحِفْظًا مِّن كُلِّ شَيْطَـٰنٍ مَّارِدٍ","juz":23,"page":446},{"ayah_number":8,"text_uthmani":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ","juz":23,"page":446},{"ayah_number":9,"text_uthmani":"دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ","juz":23,"page":446},{"ayah_number":10,"text_uthmani":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ","juz":23,"page":446},{"ayah_number":11,"text_uthmani":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ","juz":23,"page":446},{"ayah_number":12,"text_uthmani":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","juz":23,"page":446},{"ayah_number":13,"text_uthmani":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ","juz":23,"page":446},{"ayah_number":14,"text_uthmani":"وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ","juz":23,"page":446},{"ayah_number":15,"text_uthmani":"وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ","juz":23,"page":446},{"ayah_number":16,"text_uthmani":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","juz":23,"page":446},{"ayah_number":17,"text_uthmani":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","juz":23,"page":446},{"ayah_number":18,"text_uthmani":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ","juz":23,"page":446},{"ayah_number":19,"text_uthmani":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ","juz":23,"page":446},{"ayah_number":20,"text_uthmani":"وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ","juz":23,"page":446},{"ayah_number":21,"text_uthmani":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","juz":23,"page":446},{"ayah_number":22,"text_uthmani":"ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ","juz":23,"page":446},{"ayah_number":23,"text_uthmani":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ","juz":23,"page":446},{"ayah_number":24,"text_uthmani":"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ","juz":23,"page":446},{"ayah_number":25,"text_uthmani":"مَا لَكُمْ لَا تَنَاصَرُونَ","juz":23,"page":447},{"ayah_number":26,"text_uthmani":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","juz":23,"page":447},{"ayah_number":27,"text_uthmani":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","juz":23,"page":447},{"ayah_number":28,"text_uthmani":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","juz":23,"page":447},{"ayah_number":29,"text_uthmani":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ","juz":23,"page":447},{"ayah_number":30,"text_uthmani":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ","juz":23,"page":447},{"ayah_number":31,"text_uthmani":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ","juz":23,"page":447},{"ayah_number":32,"text_uthmani":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ","juz":23,"page":447},{"ayah_number":33,"text_uthmani":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","juz":23,"page":447},{"ayah_number":34,"text_uthmani":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","juz":23,"page":447},{"ayah_number":35,"text_uthmani":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","juz":23,"page":447},{"ayah_number":36,"text_uthmani":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ","juz":23,"page":447},{"ayah_number":37,"text_uthmani":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","juz":23,"page":447},{"ayah_number":38,"text_uthmani":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ","juz":23,"page":447},{"ayah_number":39,"text_uthmani":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","juz":23,"page":447},{"ayah_number":40,"text_uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","juz":23,"page":447},{"ayah_number":41,"text_uthmani":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ","juz":23,"page":447},{"ayah_number":42,"text_uthmani":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ","juz":23,"page":447},{"ayah_number":43,"text_uthmani":"فِى جَنَّـٰتِ ٱلنَّعِيمِ","juz":23,"page":447},{"ayah_number":44,"text_uthmani":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ","juz":23,"page":447},{"ayah_number":45,"text_uthmani":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ","juz":23,"page":447},{"ayah_number":46,"text_uthmani":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ","juz":23,"page":447},{"ayah_number":47,"text_uthmani":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ","juz":23,"page":447},{"ayah_number":48,"text_uthmani":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ","juz":23,"page":447},{"ayah_number":49,"text_uthmani":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","juz":23,"page":447},{"ayah_number":50,"text_uthmani":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","juz":23,"page":447},{"ayah_number":51,"text_uthmani":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ","juz":23,"page":447},{"ayah_number":52,"text_uthmani":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ","juz":23,"page":448},{"ayah_number":53,"text_uthmani":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ","juz":23,"page":448},{"ayah_number":54,"text_uthmani":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","juz":23,"page":448},{"ayah_number":55,"text_uthmani":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ","juz":23,"page":448},{"ayah_number":56,"text_uthmani":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ","juz":23,"page":448},{"ayah_number":57,"text_uthmani":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ","juz":23,"page":448},{"ayah_number":58,"text_uthmani":"أَفَمَا نَحْنُ بِمَيِّتِينَ","juz":23,"page":448},{"ayah_number":59,"text_uthmani":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","juz":23,"page":448},{"ayah_number":60,"text_uthmani":"إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","juz":23,"page":448},{"ayah_number":61,"text_uthmani":"لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ","juz":23,"page":448},{"ayah_number":62,"text_uthmani":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ","juz":23,"page":448},{"ayah_number":63,"text_uthmani":"إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ","juz":23,"page":448},{"ayah_number":64,"text_uthmani":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ","juz":23,"page":448},{"ayah_number":65,"text_uthmani":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ","juz":23,"page":448},{"ayah_number":66,"text_uthmani":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","juz":23,"page":448},{"ayah_number":67,"text_uthmani":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ","juz":23,"page":448},{"ayah_number":68,"text_uthmani":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ","juz":23,"page":448},{"ayah_number":69,"text_uthmani":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ","juz":23,"page":448},{"ayah_number":70,"text_uthmani":"فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ","juz":23,"page":448},{"ayah_number":71,"text_uthmani":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ","juz":23,"page":448},{"ayah_number":72,"text_uthmani":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ","juz":23,"page":448},{"ayah_number":73,"text_uthmani":"فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ","juz":23,"page":448},{"ayah_number":74,"text_uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","juz":23,"page":448},{"ayah_number":75,"text_uthmani":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ","juz":23,"page":448},{"ayah_number":76,"text_uthmani":"وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","juz":23,"page":448},{"ayah_number":77,"text_uthmani":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ","juz":23,"page":449},{"ayah_number":78,"text_uthmani":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ","juz":23,"page":449},{"ayah_number":79,"text_uthmani":"سَلَـٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَـٰلَمِينَ","juz":23,"page":449},{"ayah_number":80,"text_uthmani":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","juz":23,"page":449},{"ayah_number":81,"text_uthmani":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","juz":23,"page":449},{"ayah_number":82,"text_uthmani":"ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ","juz":23,"page":449},{"ayah_number":83,"text_uthmani":"وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ","juz":23,"page":449},{"ayah_number":84,"text_uthmani":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ","juz":23,"page":449},{"ayah_number":85,"text_uthmani":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ","juz":23,"page":449},{"ayah_number":86,"text_uthmani":"أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ","juz":23,"page":449},{"ayah_number":87,"text_uthmani":"فَمَا ظَنُّكُم بِرَبِّ ٱلْعَـٰلَمِينَ","juz":23,"page":449},{"ayah_number":88,"text_uthmani":"فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ","juz":23,"page":449},{"ayah_number":89,"text_uthmani":"فَقَالَ إِنِّى سَقِيمٌ","juz":23,"page":449},{"ayah_number":90,"text_uthmani":"فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ","juz":23,"page":449},{"ayah_number":91,"text_uthmani":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ","juz":23,"page":449},{"ayah_number":92,"text_uthmani":"مَا لَكُمْ لَا تَنطِقُونَ","juz":23,"page":449},{"ayah_number":93,"text_uthmani":"فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ","juz":23,"page":449},{"ayah_number":94,"text_uthmani":"فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ","juz":23,"page":449},{"ayah_number":95,"text_uthmani":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ","juz":23,"page":449},{"ayah_number":96,"text_uthmani":"وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ","juz":23,"page":449},{"ayah_number":97,"text_uthmani":"قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ","juz":23,"page":449},{"ayah_number":98,"text_uthmani":"فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَ