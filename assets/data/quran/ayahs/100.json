{"surah_id":100,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْعَـٰدِيَـٰتِ ضَبْحًا","juz":30,"page":599},{"ayah_number":2,"text_uthmani":"فَٱلْمُورِيَـٰتِ قَدْحًا","juz":30,"page":599},{"ayah_number":3,"text_uthmani":"فَٱلْمُغِيرَٰتِ صُبْحًا","juz":30,"page":599},{"ayah_number":4,"text_uthmani":"فَأَثَرْنَ بِهِۦ نَقْعًا","juz":30,"page":599},{"ayah_number":5,"text_uthmani":"فَوَسَطْنَ بِهِۦ جَمْعًا","juz":30,"page":599},{"ayah_number":6,"text_uthmani":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","juz":30,"page":599},{"ayah_number":7,"text_uthmani":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","juz":30,"page":599},{"ayah_number":8,"text_uthmani":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","juz":30,"page":599},{"ayah_number":9,"text_uthmani":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","juz":30,"page":599},{"ayah_number":10,"text_uthmani":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","juz":30,"page":600},{"ayah_number":11,"text_uthmani":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ","juz":30,"page":600}]}