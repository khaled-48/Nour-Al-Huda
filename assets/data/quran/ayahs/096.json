{"surah_id":96,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","juz":30,"page":597},{"ayah_number":2,"text_uthmani":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","juz":30,"page":597},{"ayah_number":3,"text_uthmani":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","juz":30,"page":597},{"ayah_number":4,"text_uthmani":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","juz":30,"page":597},{"ayah_number":5,"text_uthmani":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","juz":30,"page":597},{"ayah_number":6,"text_uthmani":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","juz":30,"page":597},{"ayah_number":7,"text_uthmani":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","juz":30,"page":597},{"ayah_number":8,"text_uthmani":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","juz":30,"page":597},{"ayah_number":9,"text_uthmani":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","juz":30,"page":597},{"ayah_number":10,"text_uthmani":"عَبْدًا إِذَا صَلَّىٰٓ","juz":30,"page":597},{"ayah_number":11,"text_uthmani":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","juz":30,"page":597},{"ayah_number":12,"text_uthmani":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","juz":30,"page":597},{"ayah_number":13,"text_uthmani":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","juz":30,"page":597},{"ayah_number":14,"text_uthmani":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","juz":30,"page":597},{"ayah_number":15,"text_uthmani":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","juz":30,"page":597},{"ayah_number":16,"text_uthmani":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","juz":30,"page":597},{"ayah_number":17,"text_uthmani":"فَلْيَدْعُ نَادِيَهُۥ","juz":30,"page":597},{"ayah_number":18,"text_uthmani":"سَنَدْعُ ٱلزَّبَانِيَةَ","juz":30,"page":597},{"ayah_number":19,"text_uthmani":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","juz":30,"page":597}]}