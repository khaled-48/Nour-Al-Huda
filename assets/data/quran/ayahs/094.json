{"surah_id":94,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","juz":30,"page":596},{"ayah_number":2,"text_uthmani":"وَوَضَعْنَا عَنكَ وِزْرَكَ","juz":30,"page":596},{"ayah_number":3,"text_uthmani":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","juz":30,"page":596},{"ayah_number":4,"text_uthmani":"وَرَفَعْنَا لَكَ ذِكْرَكَ","juz":30,"page":596},{"ayah_number":5,"text_uthmani":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","juz":30,"page":596},{"ayah_number":6,"text_uthmani":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","juz":30,"page":596},{"ayah_number":7,"text_uthmani":"فَإِذَا فَرَغْتَ فَٱنصَبْ","juz":30,"page":596},{"ayah_number":8,"text_uthmani":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","juz":30,"page":596}]}