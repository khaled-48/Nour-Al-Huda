{"surah_id":83,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَيْلٌ لِّلْمُطَفِّفِينَ","juz":30,"page":587},{"ayah_number":2,"text_uthmani":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","juz":30,"page":587},{"ayah_number":3,"text_uthmani":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","juz":30,"page":587},{"ayah_number":4,"text_uthmani":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","juz":30,"page":587},{"ayah_number":5,"text_uthmani":"لِيَوْمٍ عَظِيمٍ","juz":30,"page":587},{"ayah_number":6,"text_uthmani":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ","juz":30,"page":587},{"ayah_number":7,"text_uthmani":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ","juz":30,"page":588},{"ayah_number":8,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ","juz":30,"page":588},{"ayah_number":9,"text_uthmani":"كِتَـٰبٌ مَّرْقُومٌ","juz":30,"page":588},{"ayah_number":10,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":30,"page":588},{"ayah_number":11,"text_uthmani":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","juz":30,"page":588},{"ayah_number":12,"text_uthmani":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","juz":30,"page":588},{"ayah_number":13,"text_uthmani":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","juz":30,"page":588},{"ayah_number":14,"text_uthmani":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","juz":30,"page":588},{"ayah_number":15,"text_uthmani":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ","juz":30,"page":588},{"ayah_number":16,"text_uthmani":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","juz":30,"page":588},{"ayah_number":17,"text_uthmani":"ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","juz":30,"page":588},{"ayah_number":18,"text_uthmani":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","juz":30,"page":588},{"ayah_number":19,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","juz":30,"page":588},{"ayah_number":20,"text_uthmani":"كِتَـٰبٌ مَّرْقُومٌ","juz":30,"page":588},{"ayah_number":21,"text_uthmani":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","juz":30,"page":588},{"ayah_number":22,"text_uthmani":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","juz":30,"page":588},{"ayah_number":23,"text_uthmani":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","juz":30,"page":588},{"ayah_number":24,"text_uthmani":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","juz":30,"page":588},{"ayah_number":25,"text_uthmani":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ","juz":30,"page":588},{"ayah_number":26,"text_uthmani":"خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ","juz":30,"page":588},{"ayah_number":27,"text_uthmani":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","juz":30,"page":588},{"ayah_number":28,"text_uthmani":"عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","juz":30,"page":588},{"ayah_number":29,"text_uthmani":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","juz":30,"page":588},{"ayah_number":30,"text_uthmani":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","juz":30,"page":588},{"ayah_number":31,"text_uthmani":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","juz":30,"page":588},{"ayah_number":32,"text_uthmani":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ","juz":30,"page":588},{"ayah_number":33,"text_uthmani":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ","juz":30,"page":588},{"ayah_number":34,"text_uthmani":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","juz":30,"page":588},{"ayah_number":35,"text_uthmani":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","juz":30,"page":589},{"ayah_number":36,"text_uthmani":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","juz":30,"page":589}]}