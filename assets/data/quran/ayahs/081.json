{"surah_id":81,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","juz":30,"page":586},{"ayah_number":2,"text_uthmani":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","juz":30,"page":586},{"ayah_number":3,"text_uthmani":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","juz":30,"page":586},{"ayah_number":4,"text_uthmani":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","juz":30,"page":586},{"ayah_number":5,"text_uthmani":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","juz":30,"page":586},{"ayah_number":6,"text_uthmani":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","juz":30,"page":586},{"ayah_number":7,"text_uthmani":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","juz":30,"page":586},{"ayah_number":8,"text_uthmani":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","juz":30,"page":586},{"ayah_number":9,"text_uthmani":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","juz":30,"page":586},{"ayah_number":10,"text_uthmani":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","juz":30,"page":586},{"ayah_number":11,"text_uthmani":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","juz":30,"page":586},{"ayah_number":12,"text_uthmani":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","juz":30,"page":586},{"ayah_number":13,"text_uthmani":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","juz":30,"page":586},{"ayah_number":14,"text_uthmani":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","juz":30,"page":586},{"ayah_number":15,"text_uthmani":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","juz":30,"page":586},{"ayah_number":16,"text_uthmani":"ٱلْجَوَارِ ٱلْكُنَّسِ","juz":30,"page":586},{"ayah_number":17,"text_uthmani":"وَٱلَّيْلِ إِذَا عَسْعَسَ","juz":30,"page":586},{"ayah_number":18,"text_uthmani":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","juz":30,"page":586},{"ayah_number":19,"text_uthmani":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","juz":30,"page":586},{"ayah_number":20,"text_uthmani":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","juz":30,"page":586},{"ayah_number":21,"text_uthmani":"مُّطَاعٍ ثَمَّ أَمِينٍ","juz":30,"page":586},{"ayah_number":22,"text_uthmani":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","juz":30,"page":586},{"ayah_number":23,"text_uthmani":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","ju