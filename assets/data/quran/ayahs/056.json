{"surah_id":56,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","juz":27,"page":534},{"ayah_number":2,"text_uthmani":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","juz":27,"page":534},{"ayah_number":3,"text_uthmani":"خَافِضَةٌ رَّافِعَةٌ","juz":27,"page":534},{"ayah_number":4,"text_uthmani":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا","juz":27,"page":534},{"ayah_number":5,"text_uthmani":"وَبُسَّتِ ٱلْجِبَالُ بَسًّا","juz":27,"page":534},{"ayah_number":6,"text_uthmani":"فَكَانَتْ هَبَآءً مُّنۢبَثًّا","juz":27,"page":534},{"ayah_number":7,"text_uthmani":"وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً","juz":27,"page":534},{"ayah_number":8,"text_uthmani":"فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ","juz":27,"page":534},{"ayah_number":9,"text_uthmani":"وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","juz":27,"page":534},{"ayah_number":10,"text_uthmani":"وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ","juz":27,"page":534},{"ayah_number":11,"text_uthmani":"أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ","juz":27,"page":534},{"ayah_number":12,"text_uthmani":"فِى جَنَّـٰتِ ٱلنَّعِيمِ","juz":27,"page":534},{"ayah_number":13,"text_uthmani":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","juz":27,"page":534},{"ayah_number":14,"text_uthmani":"وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ","juz":27,"page":534},{"ayah_number":15,"text_uthmani":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ","juz":27,"page":534},{"ayah_number":16,"text_uthmani":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ","juz":27,"page":534},{"ayah_number":17,"text_uthmani":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ","juz":27,"page":535},{"ayah_number":18,"text_uthmani":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ","juz":27,"page":535},{"ayah_number":19,"text_uthmani":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","juz":27,"page":535},{"ayah_number":20,"text_uthmani":"وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","juz":27,"page":535},{"ayah_number":21,"text_uthmani":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ","juz":27,"page":535},{"ayah_number":22,"text_uthmani":"وَحُورٌ عِينٌ","juz":27,"page":535},{"ayah_number":23,"text_uthmani":"كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","juz":27,"page":535},{"ayah_number":24,"text_uthmani":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","juz":27,"page":535},{"ayah_number":25,"text_uthmani":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا","juz":27,"page":535},{"ayah_number":26,"text_uthmani":"إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا","juz":27,"page":535},{"ayah_number":27,"text_uthmani":"وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ","juz":27,"page":535},{"ayah_number":28,"text_uthmani":"فِى سِدْرٍ مَّخْضُودٍ","juz":27,"page":535},{"ayah_number":29,"text_uthmani":"وَطَلْحٍ مَّنضُودٍ","juz":27,"page":535},{"ayah_number":30,"text_uthmani":"وَظِلٍّ مَّمْدُودٍ","juz":27,"page":535},{"ayah_number":31,"text_uthmani":"وَمَآءٍ مَّسْكُوبٍ","juz":27,"page":535},{"ayah_number":32,"text_uthmani":"وَفَـٰكِهَةٍ كَثِيرَةٍ","juz":27,"page":535},{"ayah_number":33,"text_uthmani":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ","juz":27,"page":535},{"ayah_number":34,"text_uthmani":"وَفُرُشٍ مَّرْفُوعَةٍ","juz":27,"page":535},{"ayah_number":35,"text_uthmani":"إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً","juz":27,"page":535},{"ayah_number":36,"text_uthmani":"فَجَعَلْنَـٰهُنَّ أَبْكَارًا","juz":27,"page":535},{"ayah_number":37,"text_uthmani":"عُرُبًا أَتْرَابًا","juz":27,"page":535},{"ayah_number":38,"text_uthmani":"لِّأَصْحَـٰبِ ٱلْيَمِينِ","juz":27,"page":535},{"ayah_number":39,"text_uthmani":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","juz":27,"page":535},{"ayah_number":40,"text_uthmani":"وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ","juz":27,"page":535},{"ayah_number":41,"text_uthmani":"وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ","juz":27,"page":535},{"ayah_number":42,"text_uthmani":"فِى سَمُومٍ وَحَمِيمٍ","juz":27,"page":535},{"ayah_number":43,"text_uthmani":"وَظِلٍّ مِّن يَحْمُومٍ","juz":27,"page":535},{"ayah_number":44,"text_uthmani":"لَّا بَارِدٍ وَلَا كَرِيمٍ","juz":27,"page":535},{"ayah_number":45,"text_uthmani":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","juz":27,"page":535},{"ayah_number":46,"text_uthmani":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","juz":27,"page":535},{"ayah_number":47,"text_uthmani":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","juz":27,"page":535},{"ayah_number":48,"text_uthmani":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","juz":27,"page":535},{"ayah_number":49,"text_uthmani":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ","juz":27,"page":535},{"ayah_number":50,"text_uthmani":"لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ","juz":27,"page":535},{"ayah_number":51,"text_uthmani":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","juz":27,"page":536},{"ayah_number":52,"text_uthmani":"لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ","juz":27,"page":536},{"ayah_number":53,"text_uthmani":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","juz":27,"page":536},{"ayah_number":54,"text_uthmani":"فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","juz":27,"page":536},{"ayah_number":55,"text_uthmani":"فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ","juz":27,"page":536},{"ayah_number":56,"text_uthmani":"هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","juz":27,"page":536},{"ayah_number":57,"text_uthmani":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ","juz":27,"page":536},{"ayah_number":58,"text_uthmani":"أَفَرَءَيْتُم مَّا تُمْنُونَ","juz":27,"page":536},{"ayah_number":59,"text_uthmani":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ","juz":27,"page":536},{"ayah_number":60,"text_uthmani":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","juz":27,"page":536},{"ayah_number":61,"text_uthmani":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","juz":27,"page":536},{"ayah_number":62,"text_uthmani":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","juz":27,"page":536},{"ayah_number":63,"text_uthmani":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","juz":27,"page":536},{"ayah_number":64,"text_uthmani":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","juz":27,"page":536},{"ayah_number":65,"text_uthmani":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ","juz":27,"page":536},{"ayah_number":66,"text_uthmani":"إِنَّا لَمُغْرَمُونَ","juz":27,"page":536},{"ayah_number":67,"text_uthmani":"بَلْ نَحْنُ مَحْرُومُونَ","juz":27,"page":536},{"ayah_number":68,"text_uthmani":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","juz":27,"page":536},{"ayah_number":69,"text_uthmani":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","juz":27,"page":536},{"ayah_number":70,"text_uthmani":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ","juz":27,"page":536},{"ayah_number":71,"text_uthmani":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","juz":27,"page":536},{"ayah_number":72,"text_uthmani":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","juz":27,"page":536},{"ayah_number":73,"text_uthmani":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ","juz":27,"page":536},{"ayah_number":74,"text_uthmani":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","juz":27,"page":536},{"ayah_number":75,"text_uthmani":"فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","juz":27,"page":536},{"ayah_number":76,"text_uthmani":"وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ","juz":27,"page":536},{"ayah_number":77,"text_uthmani":"إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ","juz":27,"page":537},{"ayah_number":78,"text_uthmani":"فِى كِتَـٰبٍ مَّكْنُونٍ","juz":27,"page":537},{"ayah_number":79,"text_uthmani":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","juz":27,"page":537},{"ayah_number":80,"text_uthmani":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","juz":27,"page":537},{"ayah_number":81,"text_uthmani":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","juz":27,"page":537},{"ayah_number":82,"text_uthmani":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","juz":27,"page":537},{"ayah_number":83,"text_uthmani":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","juz":27,"page":537},{"ayah_number":84,"text_uthmani":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ","juz":27,"page":537},{"ayah_number":85,"text_uthmani":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ","juz":27,"page":537},{"ayah_number":86,"text_uthmani":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","juz":27,"page":537},{"ayah_number":87,"text_uthmani":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ","juz":27,"page":537},{"ayah_number":88,"text_uthmani":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","juz":27,"page":537},{"ayah_number":89,"text_uthmani":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ","juz":27,"page":537},{"ayah_number":90,"text_uthmani":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","juz":27,"page":537},{"ayah_number":91,"text_uthmani":"فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","juz":27,"page":537},{"ayah_number":92,"text_uthmani":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","juz":27,"page":537},{"ayah_number":93,"text_uthmani":"فَنُزُلٌ مِّنْ حَمِيمٍ","juz":27,"page":537},{"ayah_number":94,"text_uthmani":"وَتَصْلِيَةُ جَحِيمٍ","juz":27,"page":537},{"ayah_number":95,"text_uthmani":"إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","juz":27,"page":537},{"ayah_number":96,"text_uthmani":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","juz":27,"page":537}]}