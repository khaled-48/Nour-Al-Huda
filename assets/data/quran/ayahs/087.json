{"surah_id":87,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","juz":30,"page":591},{"ayah_number":2,"text_uthmani":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","juz":30,"page":591},{"ayah_number":3,"text_uthmani":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","juz":30,"page":591},{"ayah_number":4,"text_uthmani":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","juz":30,"page":591},{"ayah_number":5,"text_uthmani":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","juz":30,"page":591},{"ayah_number":6,"text_uthmani":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","juz":30,"page":591},{"ayah_number":7,"text_uthmani":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","juz":30,"page":591},{"ayah_number":8,"text_uthmani":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","juz":30,"page":591},{"ayah_number":9,"text_uthmani":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","juz":30,"page":591},{"ayah_number":10,"text_uthmani":"سَيَذَّكَّرُ مَن يَخْشَىٰ","juz":30,"page":591},{"ayah_number":11,"text_uthmani":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","juz":30,"page":591},{"ayah_number":12,"text_uthmani":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","juz":30,"page":591},{"ayah_number":13,"text_uthmani":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","juz":30,"page":591},{"ayah_number":14,"text_uthmani":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","juz":30,"page":591},{"ayah_number":15,"text_uthmani":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","juz":30,"page":591},{"ayah_number":16,"text_uthmani":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","juz":30,"page":592},{"ayah_number":17,"text_uthmani":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","juz":30,"page":592},{"ayah_number":18,"text_uthmani":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","juz":30,"page":592},{"ayah_number":19,"text_uthmani":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","juz":30,"page":592}]}