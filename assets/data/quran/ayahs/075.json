{"surah_id":75,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","juz":29,"page":577},{"ayah_number":2,"text_uthmani":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","juz":29,"page":577},{"ayah_number":3,"text_uthmani":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","juz":29,"page":577},{"ayah_number":4,"text_uthmani":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","juz":29,"page":577},{"ayah_number":5,"text_uthmani":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","juz":29,"page":577},{"ayah_number":6,"text_uthmani":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","juz":29,"page":577},{"ayah_number":7,"text_uthmani":"فَإِذَا بَرِقَ ٱلْبَصَرُ","juz":29,"page":577},{"ayah_number":8,"text_uthmani":"وَخَسَفَ ٱلْقَمَرُ","juz":29,"page":577},{"ayah_number":9,"text_uthmani":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","juz":29,"page":577},{"ayah_number":10,"text_uthmani":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","juz":29,"page":577},{"ayah_number":11,"text_uthmani":"كَلَّا لَا وَزَرَ","juz":29,"page":577},{"ayah_number":12,"text_uthmani":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","juz":29,"page":577},{"ayah_number":13,"text_uthmani":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","juz":29,"page":577},{"ayah_number":14,"text_uthmani":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","juz":29,"page":577},{"ayah_number":15,"text_uthmani":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","juz":29,"page":577},{"ayah_number":16,"text_uthmani":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","juz":29,"page":577},{"ayah_number":17,"text_uthmani":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","juz":29,"page":577},{"ayah_number":18,"text_uthmani":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","juz":29,"page":577},{"ayah_number":19,"text_uthmani":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","juz":29,"page":577},{"ayah_number":20,"text_uthmani":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","juz":29,"page":578},{"ayah_number":21,"text_uthmani":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","juz":29,"page":578},{"ayah_number":22,"text_uthmani":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","juz":29,"page":578},{"ayah_number":23,"text_uthmani":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","juz":29,"page":578},{"ayah_number":24,"text_uthmani":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","juz":29,"page":578},{"ayah_number":25,"text_uthmani":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","juz":29,"page":578},{"ayah_number":26,"text_uthmani":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","juz":29,"page":578},{"ayah_number":27,"text_uthmani":"وَقِيلَ مَنْ ۜ رَاقٍ","juz":29,"page":578},{"ayah_number":28,"text_uthmani":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","juz":29,"page":578},{"ayah_number":29,"text_uthmani":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","juz":29,"page":578},{"ayah_number":30,"text_uthmani":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","juz":29,"page":578},{"ayah_number":31,"text_uthmani":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","juz":29,"page":578},{"ayah_number":32,"text_uthmani":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ","juz":29,"page":578},{"ayah_number":33,"text_uthmani":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","juz":29,"page":578},{"ayah_number":34,"text_uthmani":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","juz":29,"page":578},{"ayah_number":35,"text_uthmani":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","juz":29,"page":578},{"ayah_number":36,"text_uthmani":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى","juz":29,"page":578},{"ayah_number":37,"text_uthmani":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","juz":29,"page":578},{"ayah_number":38,"text_uthmani":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","juz":29,"page":578},{"ayah_number":39,"text_uthmani":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","juz":29,"page":578},{"ayah_number":40,"text_uthmani":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","juz":29,"page":578}]}