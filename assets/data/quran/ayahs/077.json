{"surah_id":77,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَـٰتِ عُرْفًا","juz":29,"page":580},{"ayah_number":2,"text_uthmani":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا","juz":29,"page":580},{"ayah_number":3,"text_uthmani":"وَٱلنَّـٰشِرَٰتِ نَشْرًا","juz":29,"page":580},{"ayah_number":4,"text_uthmani":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا","juz":29,"page":580},{"ayah_number":5,"text_uthmani":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","juz":29,"page":580},{"ayah_number":6,"text_uthmani":"عُذْرًا أَوْ نُذْرًا","juz":29,"page":580},{"ayah_number":7,"text_uthmani":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","juz":29,"page":580},{"ayah_number":8,"text_uthmani":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","juz":29,"page":580},{"ayah_number":9,"text_uthmani":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","juz":29,"page":580},{"ayah_number":10,"text_uthmani":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","juz":29,"page":580},{"ayah_number":11,"text_uthmani":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","juz":29,"page":580},{"ayah_number":12,"text_uthmani":"لِأَىِّ يَوْمٍ أُجِّلَتْ","juz":29,"page":580},{"ayah_number":13,"text_uthmani":"لِيَوْمِ ٱلْفَصْلِ","juz":29,"page":580},{"ayah_number":14,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","juz":29,"page":580},{"ayah_number":15,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":580},{"ayah_number":16,"text_uthmani":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","juz":29,"page":580},{"ayah_number":17,"text_uthmani":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ","juz":29,"page":580},{"ayah_number":18,"text_uthmani":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","juz":29,"page":580},{"ayah_number":19,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":580},{"ayah_number":20,"text_uthmani":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ","juz":29,"page":581},{"ayah_number":21,"text_uthmani":"فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ","juz":29,"page":581},{"ayah_number":22,"text_uthmani":"إِلَىٰ قَدَرٍ مَّعْلُومٍ","juz":29,"page":581},{"ayah_number":23,"text_uthmani":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ","juz":29,"page":581},{"ayah_number":24,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":25,"text_uthmani":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","juz":29,"page":581},{"ayah_number":26,"text_uthmani":"أَحْيَآءً وَأَمْوَٰتًا","juz":29,"page":581},{"ayah_number":27,"text_uthmani":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا","juz":29,"page":581},{"ayah_number":28,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":29,"text_uthmani":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","juz":29,"page":581},{"ayah_number":30,"text_uthmani":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ","juz":29,"page":581},{"ayah_number":31,"text_uthmani":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","juz":29,"page":581},{"ayah_number":32,"text_uthmani":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ","juz":29,"page":581},{"ayah_number":33,"text_uthmani":"كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ","juz":29,"page":581},{"ayah_number":34,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":35,"text_uthmani":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ","juz":29,"page":581},{"ayah_number":36,"text_uthmani":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","juz":29,"page":581},{"ayah_number":37,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":38,"text_uthmani":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ","juz":29,"page":581},{"ayah_number":39,"text_uthmani":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","juz":29,"page":581},{"ayah_number":40,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":41,"text_uthmani":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ","juz":29,"page":581},{"ayah_number":42,"text_uthmani":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","juz":29,"page":581},{"ayah_number":43,"text_uthmani":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","juz":29,"page":581},{"ayah_number":44,"text_uthmani":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","juz":29,"page":581},{"ayah_number":45,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":46,"text_uthmani":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","juz":29,"page":581},{"ayah_number":47,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":48,"text_uthmani":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","juz":29,"page":581},{"ayah_number":49,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","juz":29,"page":581},{"ayah_number":50,"text_uthmani":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","juz":29,"page":581}]}