{"surah_id":108,"ayahs":[{"ayah_number":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","juz":30,"page":602},{"ayah_number":2,"text_uthmani":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","juz":30,"page":602},{"ayah_number":3,"text_uthmani":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","juz":30,"page":602}]}